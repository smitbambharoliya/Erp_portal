{% extends 'base.html.twig' %}

{% block title %}Projects — CoreUI ERP Portal{% endblock %}
{% block page_heading %}Projects{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">
        <h5><i class="fa-solid fa-diagram-project" style="margin-right:8px; color:var(--primary);"></i> Company Projects</h5>
        <a href="{{ path('app_project_new') }}" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> New Project
        </a>
    </div>
    <div class="card-body" style="padding:0;">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Project Name</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Budget</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for project in projects %}
                    <tr>
                        <td><strong>#{{ project.id }}</strong></td>
                        <td>
                            <strong>{{ project.name }}</strong>
                            <div style="font-size:0.75rem; color:var(--text-mute);">{{ project.description|slice(0, 45) ~ '...' }}</div>
                        </td>
                        <td>{{ project.startDate ?? '-' }}</td>
                        <td>{{ project.endDate ?? '-' }}</td>
                        <td>₹{{ project.budget ?? 0 }}</td>
                        <td>
                            <span class="badge {{ project.status == 'Completed' ? 'badge-success' : (project.status == 'In Progress' ? 'badge-info' : 'badge-warning') }}">
                                {{ project.status ?? 'Active' }}
                            </span>
                        </td>
                        <td>
                            <a href="{{ path('app_project_show', {'id': project.id}) }}" class="btn btn-sm btn-secondary"><i class="fa-solid fa-eye"></i></a>
                            <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" style="text-align:center; padding:40px; color:var(--text-mute);">
                            No project records found.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
