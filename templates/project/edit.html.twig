{% extends 'base.html.twig' %}

{% block title %}Edit Project — CoreUI ERP Portal{% endblock %}
{% block page_heading %}Edit Project{% endblock %}

{% block body %}
<div class="card" style="max-width:650px; margin:0 auto;">
    <div class="card-header">
        <h5><i class="fa-solid fa-pen-to-square" style="margin-right:8px; color:var(--primary);"></i> Edit {{ project.name }}</h5>
        <a href="{{ path('app_project_index') }}" class="btn btn-secondary btn-sm">
            <i class="fa-solid fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="card-body">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="form-group">
                {{ form_label(form.name) }}
                {{ form_widget(form.name) }}
                {{ form_errors(form.name) }}
            </div>
            <div class="form-group">
                {{ form_label(form.description) }}
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.startDate) }}
                    {{ form_widget(form.startDate) }}
                    {{ form_errors(form.startDate) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.endDate) }}
                    {{ form_widget(form.endDate) }}
                    {{ form_errors(form.endDate) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.budget) }}
                    {{ form_widget(form.budget) }}
                    {{ form_errors(form.budget) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.status) }}
                    {{ form_widget(form.status) }}
                    {{ form_errors(form.status) }}
                </div>
            </div>

            <div style="margin-top:20px; display:flex; justify-content:space-between; align-items:center;">
                {% if is_granted('ROLE_ADMIN') %}
                {{ include('project/_delete_form.html.twig') }}
                {% else %}
                <div></div>
                {% endif %}
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i> Save Changes
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
