{% extends 'base.html.twig' %}

{% block title %}Employees — CoreUI ERP Portal{% endblock %}
{% block page_heading %}Employees{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">
        <h5><i class="fa-solid fa-users" style="margin-right:8px; color:var(--primary);"></i> Employee Directory</h5>
        {% if is_granted('ROLE_HR') %}
        <a href="{{ path('app_employee_new') }}" class="btn btn-primary">
            <i class="fa-solid fa-user-plus"></i> Add Employee
        </a>
        {% endif %}
    </div>
    <div class="card-body" style="padding:0;">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Designation</th>
                        <th>Department</th>
                        <th>Phone</th>
                        <th>Joining Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for employee in employees %}
                    <tr>
                        <td><strong>#{{ employee.id }}</strong></td>
                        <td>
                            <strong>{{ employee.firstName }} {{ employee.lastName }}</strong>
                            {% if employee.user %}<div style="font-size:0.75rem; color:var(--text-mute);">{{ employee.user.email }}</div>{% endif %}
                        </td>
                        <td>{{ employee.designation ?? 'N/A' }}</td>
                        <td>
                            {% if employee.department %}
                                <span class="badge badge-info"><i class="fa-solid fa-sitemap"></i> {{ employee.department.name }}</span>
                            {% else %}
                                <span style="color:var(--text-mute);">Unassigned</span>
                            {% endif %}
                        </td>
                        <td>{{ employee.phone ?? '-' }}</td>
                        <td>{{ employee.joiningDate ?? '-' }}</td>
                        <td>
                            <span class="badge {{ employee.status == 'Active' ? 'badge-success' : 'badge-danger' }}">
                                {{ employee.status ?? 'Active' }}
                            </span>
                        </td>
                        <td>
                            <a href="{{ path('app_employee_show', {'id': employee.id}) }}" class="btn btn-sm btn-secondary" title="View"><i class="fa-solid fa-eye"></i></a>
                            {% if is_granted('ROLE_HR') %}
                            <a href="{{ path('app_employee_edit', {'id': employee.id}) }}" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" style="text-align:center; padding:40px; color:var(--text-mute);">
                            No employee records found.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
