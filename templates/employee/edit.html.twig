{% extends 'base.html.twig' %}

{% block title %}Edit Employee — ERP Portal{% endblock %}
{% block page_heading %}Edit Employee{% endblock %}
{% block page_subheading %}Update employee profile and department details{% endblock %}

{% block body %}
<div class="card-panel" style="max-width:800px; margin:0 auto;">
    <div class="card-header-flex">
        <h2><i class="fa-solid fa-user-pen" style="margin-right:8px; color:var(--primary);"></i> Edit {{ employee.firstName }} {{ employee.lastName }}</h2>
        <a href="{{ path('app_employee_index') }}" class="btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Back to List
        </a>
    </div>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        <div class="form-grid">
            <div class="form-group">
                {{ form_label(form.firstName) }}
                {{ form_widget(form.firstName) }}
                {{ form_errors(form.firstName) }}
            </div>
            <div class="form-group">
                {{ form_label(form.lastName) }}
                {{ form_widget(form.lastName) }}
                {{ form_errors(form.lastName) }}
            </div>
            <div class="form-group">
                {{ form_label(form.phone) }}
                {{ form_widget(form.phone) }}
                {{ form_errors(form.phone) }}
            </div>
            <div class="form-group">
                {{ form_label(form.designation) }}
                {{ form_widget(form.designation) }}
                {{ form_errors(form.designation) }}
            </div>
            <div class="form-group">
                {{ form_label(form.department) }}
                {{ form_widget(form.department) }}
                {{ form_errors(form.department) }}
            </div>
            <div class="form-group">
                {{ form_label(form.status) }}
                {{ form_widget(form.status) }}
                {{ form_errors(form.status) }}
            </div>
            <div class="form-group">
                {{ form_label(form.user) }}
                {{ form_widget(form.user) }}
                {{ form_errors(form.user) }}
            </div>
            <div class="form-group">
                {{ form_label(form.gender) }}
                {{ form_widget(form.gender) }}
                {{ form_errors(form.gender) }}
            </div>
        </div>

        <div style="margin-top:20px; display:flex; justify-content:space-between; align-items:center;">
            {% if is_granted('ROLE_ADMIN') %}
            {{ include('employee/_delete_form.html.twig') }}
            {% else %}
            <div></div>
            {% endif %}
            <button type="submit" class="btn-primary">
                <i class="fa-solid fa-check"></i> Update Changes
            </button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
