{% extends 'base.html.twig' %}

{% block title %}Attendance{% endblock %}

{% block body %}
    <h1>Attendance</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ attendance.id }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ attendance.date }}</td>
            </tr>
            <tr>
                <th>CheckIn</th>
                <td>{{ attendance.checkIn }}</td>
            </tr>
            <tr>
                <th>CheckOut</th>
                <td>{{ attendance.checkOut }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ attendance.status }}</td>
            </tr>
            <tr>
                <th>WorkingHours</th>
                <td>{{ attendance.workingHours }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ attendance.createdAt ? attendance.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_attendance_index') }}">back to list</a>

    <a href="{{ path('app_attendance_edit', {'id': attendance.id}) }}">edit</a>

    {{ include('attendance/_delete_form.html.twig') }}
{% endblock %}
