{% extends 'base.html.twig' %}

{% block title %}Attendance — CoreUI ERP Portal{% endblock %}
{% block page_heading %}Attendance Logs{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">
        <h5><i class="fa-solid fa-calendar-check" style="margin-right:8px; color:var(--success);"></i> Attendance Records</h5>
        <a href="{{ path('app_attendance_new') }}" class="btn btn-primary">
            <i class="fa-solid fa-clock"></i> Mark Attendance
        </a>
    </div>
    <div class="card-body" style="padding:0;">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Employee</th>
                        <th>Date</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for attendance in attendances %}
                    <tr>
                        <td><strong>#{{ attendance.id }}</strong></td>
                        <td>
                            <strong>
                                {% if attendance.employee %}
                                    {{ attendance.employee.firstName }} {{ attendance.employee.lastName }}
                                {% else %}
                                    Unknown Employee
                                {% endif %}
                            </strong>
                        </td>
                        <td>{{ attendance.date ?? '-' }}</td>
                        <td><span style="color:var(--success); font-weight:600;">{{ attendance.checkIn ?? '-' }}</span></td>
                        <td><span style="color:var(--danger); font-weight:600;">{{ attendance.checkOut ?? '-' }}</span></td>
                        <td>
                            {% if attendance.status == 'Present' %}
                                <span class="badge badge-success">Present</span>
                            {% elseif attendance.status == 'Absent' %}
                                <span class="badge badge-danger">Absent</span>
                            {% else %}
                                <span class="badge badge-warning">{{ attendance.status ?? 'Pending' }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_attendance_show', {'id': attendance.id}) }}" class="btn btn-sm btn-secondary"><i class="fa-solid fa-eye"></i></a>
                            {% if is_granted('ROLE_HR') %}
                            <a href="{{ path('app_attendance_edit', {'id': attendance.id}) }}" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" style="text-align:center; padding:40px; color:var(--text-mute);">
                            No attendance records found.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
