{% extends 'base.html.twig' %}

{% block title %}Edit Attendance — ERP Portal{% endblock %}
{% block page_heading %}Edit Attendance Log{% endblock %}

{% block body %}
<div class="card-panel" style="max-width:650px; margin:0 auto;">
    <div class="card-header-flex">
        <h2><i class="fa-solid fa-pen-to-square" style="margin-right:8px; color:var(--success);"></i> Edit Entry</h2>
        <a href="{{ path('app_attendance_index') }}" class="btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Back to List
        </a>
    </div>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        <div class="form-grid">
            {% if form.employee is defined %}
            <div class="form-group">
                {{ form_label(form.employee) }}
                {{ form_widget(form.employee) }}
                {{ form_errors(form.employee) }}
            </div>
            {% endif %}
            <div class="form-group">
                {{ form_label(form.date) }}
                {{ form_widget(form.date) }}
                {{ form_errors(form.date) }}
            </div>
            <div class="form-group">
                {{ form_label(form.checkIn) }}
                {{ form_widget(form.checkIn) }}
                {{ form_errors(form.checkIn) }}
            </div>
            <div class="form-group">
                {{ form_label(form.checkOut) }}
                {{ form_widget(form.checkOut) }}
                {{ form_errors(form.checkOut) }}
            </div>
            <div class="form-group">
                {{ form_label(form.status) }}
                {{ form_widget(form.status) }}
                {{ form_errors(form.status) }}
            </div>
        </div>
        <div style="margin-top:20px; display:flex; justify-content:space-between; align-items:center;">
            {% if is_granted('ROLE_ADMIN') %}
            {{ include('attendance/_delete_form.html.twig') }}
            {% else %}
            <div></div>
            {% endif %}
            <button type="submit" class="btn-primary">
                <i class="fa-solid fa-check"></i> Save Changes
            </button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
