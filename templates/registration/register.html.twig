{% extends 'base.html.twig' %}

{% block title %}Register — CoreUI ERP Portal{% endblock %}

{% block stylesheets %}
<style>
    .auth-card-wrap {
        width: 100%; max-width: 440px; padding: 20px;
    }
    .auth-card {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        padding: 36px 32px;
    }
    .auth-logo { text-align: center; margin-bottom: 24px; }
    .auth-logo-icon {
        width: 48px; height: 48px; background: linear-gradient(135deg, var(--primary), var(--info));
        border-radius: 10px; color: white; display: inline-flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: 1.3rem; margin-bottom: 10px;
    }
    .auth-logo h2 { font-size: 1.3rem; font-weight: 700; color: var(--text-main); margin: 0; }
    .auth-logo p { font-size: 0.83rem; color: var(--text-mute); margin-top: 4px; }

    .btn-auth {
        width: 100%; padding: 11px; background-color: var(--primary); color: white;
        border: none; border-radius: 6px; font-weight: 600; font-size: 0.9rem;
        cursor: pointer; transition: background 0.15s; margin-top: 8px;
    }
    .btn-auth:hover { background-color: var(--primary-hover); }

    .auth-footer-link { text-align: center; margin-top: 20px; font-size: 0.83rem; color: var(--text-mute); }
    .auth-footer-link a { color: var(--primary); text-decoration: none; font-weight: 600; }
    .auth-footer-link a:hover { text-decoration: underline; }
</style>
{% endblock %}

{% block body %}
<div class="auth-card-wrap">
    <div class="auth-card">
        <div class="auth-logo">
            <div class="auth-logo-icon">C</div>
            <h2>CoreUI ERP Portal</h2>
            <p>Create a new user account</p>
        </div>

        {% if registrationForm.vars.errors|length > 0 %}
        <div class="alert alert-danger">
            {{ form_errors(registrationForm) }}
        </div>
        {% endif %}

        {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="form-group">
                <label for="registration_form_email">Email Address</label>
                {{ form_widget(registrationForm.email, {'attr': {'placeholder': 'name@company.com'}}) }}
                {{ form_errors(registrationForm.email) }}
            </div>

            <div class="form-group">
                <label for="registration_form_role">System Role</label>
                {{ form_widget(registrationForm.role) }}
                {{ form_errors(registrationForm.role) }}
            </div>

            <div class="form-group">
                <label for="registration_form_plainPassword">Password</label>
                {{ form_widget(registrationForm.plainPassword, {'attr': {'placeholder': 'Min. 6 characters'}}) }}
                {{ form_errors(registrationForm.plainPassword) }}
            </div>

            <div class="form-group" style="display:flex; align-items:center; gap:8px;">
                {{ form_widget(registrationForm.agreeTerms, {'attr': {'style': 'accent-color:var(--primary);'}}) }}
                <label for="{{ registrationForm.agreeTerms.vars.id }}" style="margin:0; font-weight:400; font-size:0.83rem; cursor:pointer;">
                    I agree to the Terms & Conditions
                </label>
            </div>
            {{ form_errors(registrationForm.agreeTerms) }}

            <button class="btn-auth" type="submit">
                <i class="fa-solid fa-user-plus" style="margin-right:6px;"></i> Create Account
            </button>
        {{ form_end(registrationForm) }}

        <div class="auth-footer-link">
            Already have an account? <a href="{{ path('app_login') }}">Sign in here</a>
        </div>
    </div>
</div>
{% endblock %}
