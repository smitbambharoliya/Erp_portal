{% extends 'base.html.twig' %}

{% block title %}HR & Management Dashboard — HR Portal{% endblock %}
{% block page_heading %}HR & Executive Management Dashboard{% endblock %}

{% block body %}
{# HR Executive Header Banner #}
<div class="card mb-4" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); color: #ffffff; border: none; border-radius: 12px; box-shadow: 0 4px 15px rgba(79,70,229,0.25);">
    <div class="card-body" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
            <div>
                <h3 style="font-weight: 800; font-size: 1.5rem; margin-bottom: 6px; display: flex; align-items: center; gap: 10px;">
                    <i class="fa-solid fa-user-shield"></i> Company HR Operations Portal
                </h3>
                <p style="opacity: 0.9; margin: 0; font-size: 0.95rem;">
                    Company-wide management of employees, attendance, salaries, leave requests & departments.
                </p>
            </div>
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <a href="{{ path('app_employee_new') }}" class="btn" style="background: #ffffff; color: #4f46e5; font-weight: 700; padding: 10px 16px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
                    <i class="fa-solid fa-user-plus"></i> Onboard Employee
                </a>
                <a href="{{ path('app_attendance_new') }}" class="btn" style="background: rgba(255,255,255,0.2); color: #ffffff; font-weight: 600; padding: 10px 16px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(255,255,255,0.3);">
                    <i class="fa-solid fa-clock"></i> Manual Attendance
                </a>
            </div>
        </div>
    </div>
</div>

{# Executive Stat Cards Grid #}
<div class="stats-grid mb-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
    <div class="card" style="border-radius:12px; border:1px solid #e2e8f0; border-left: 4px solid #4f46e5; padding: 18px;">
        <div style="font-size: 0.8rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Total Employees</div>
        <div style="font-size: 1.8rem; font-weight: 800; color: #1e293b; margin-top: 4px;">{{ total_employees }}</div>
    </div>
    <div class="card" style="border-radius:12px; border:1px solid #e2e8f0; border-left: 4px solid #10b981; padding: 18px;">
        <div style="font-size: 0.8rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Active Staff</div>
        <div style="font-size: 1.8rem; font-weight: 800; color: #10b981; margin-top: 4px;">{{ active_employees }}</div>
    </div>
    <div class="card" style="border-radius:12px; border:1px solid #e2e8f0; border-left: 4px solid #f59e0b; padding: 18px;">
        <div style="font-size: 0.8rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Pending Leaves</div>
        <div style="font-size: 1.8rem; font-weight: 800; color: #f59e0b; margin-top: 4px;">{{ pending_leaves_count }}</div>
    </div>
    <div class="card" style="border-radius:12px; border:1px solid #e2e8f0; border-left: 4px solid #3b82f6; padding: 18px;">
        <div style="font-size: 0.8rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Checked In Today</div>
        <div style="font-size: 1.8rem; font-weight: 800; color: #3b82f6; margin-top: 4px;">{{ today_attendance_count }}</div>
    </div>
    <div class="card" style="border-radius:12px; border:1px solid #e2e8f0; border-left: 4px solid #8b5cf6; padding: 18px;">
        <div style="font-size: 0.8rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Departments</div>
        <div style="font-size: 1.8rem; font-weight: 800; color: #8b5cf6; margin-top: 4px;">{{ departments_count }}</div>
    </div>
</div>

{# Pending Leave Applications Table #}
<div class="card mb-4" style="border-radius:12px; border:1px solid #e2e8f0; overflow:hidden;">
    <div class="card-header" style="background:#ffffff; padding:16px 20px; border-bottom:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center;">
        <h5 style="margin:0; font-weight:700; color:#1e293b;">
            <i class="fa-solid fa-clock-rotate-left" style="color:#f59e0b; margin-right:8px;"></i> Pending Leave Applications ({{ pending_leaves_count }})
        </h5>
        <a href="{{ path('app_leave_request_index') }}" class="btn btn-sm btn-outline-primary" style="border-radius:6px;">View All Applications</a>
    </div>
    <div class="card-body" style="padding:0;">
        <div class="table-responsive">
            <table class="table" style="margin:0; width:100%;">
                <thead style="background:#f8fafc;">
                    <tr>
                        <th style="padding:14px 20px; font-weight:600; color:#64748b; font-size:0.8rem; text-transform:uppercase;">Employee</th>
                        <th style="padding:14px 20px; font-weight:600; color:#64748b; font-size:0.8rem; text-transform:uppercase;">Leave Type</th>
                        <th style="padding:14px 20px; font-weight:600; color:#64748b; font-size:0.8rem; text-transform:uppercase;">Start Date</th>
                        <th style="padding:14px 20px; font-weight:600; color:#64748b; font-size:0.8rem; text-transform:uppercase;">End Date</th>
                        <th style="padding:14px 20px; font-weight:600; color:#64748b; font-size:0.8rem; text-transform:uppercase;">Status</th>
                        <th style="padding:14px 20px; font-weight:600; color:#64748b; font-size:0.8rem; text-transform:uppercase; text-align:center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for leave in pending_leaves_list %}
                    <tr style="border-bottom:1px solid #f1f5f9;">
                        <td style="padding:14px 20px;">
                            <strong>
                                {% if leave.employee %}
                                    {{ leave.employee.firstName }} {{ leave.employee.lastName }}
                                {% else %}
                                    Unknown Employee
                                {% endif %}
                            </strong>
                        </td>
                        <td style="padding:14px 20px;"><span class="badge badge-info">{{ leave.leaveType ?? 'Casual Leave' }}</span></td>
                        <td style="padding:14px 20px;">{{ leave.startDate ? leave.startDate|date('Y-m-d') : '-' }}</td>
                        <td style="padding:14px 20px;">{{ leave.endDate ? leave.endDate|date('Y-m-d') : '-' }}</td>
                        <td style="padding:14px 20px;"><span class="badge badge-warning">Pending</span></td>
                        <td style="padding:14px 20px; text-align:center;">
                            <a href="{{ path('app_leave_request_approve', {'id': leave.id}) }}" class="btn btn-sm btn-success" style="border-radius:6px; margin-right:4px;">
                                <i class="fa-solid fa-check"></i> Approve
                            </a>
                            <a href="{{ path('app_leave_request_reject', {'id': leave.id}) }}" class="btn btn-sm btn-danger" style="border-radius:6px;">
                                <i class="fa-solid fa-xmark"></i> Reject
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" style="text-align:center; padding:30px; color:#94a3b8;">
                            No pending leave requests at this moment.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
