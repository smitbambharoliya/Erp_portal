{% extends 'base.html.twig' %}

{% block title %}{{ task.title }} — CoreUI ERP Portal{% endblock %}
{% block page_heading %}{{ task.title }}{% endblock %}

{% block body %}
<div class="card" style="max-width:600px; margin:0 auto;">
    <div class="card-header">
        <h5><i class="fa-solid fa-list-check" style="margin-right:8px; color:var(--info);"></i> Task #{{ task.id }} Details</h5>
        <a href="{{ path('app_task_index') }}" class="btn btn-secondary btn-sm">
            <i class="fa-solid fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="card-body" style="padding:0;">
        <div class="table-responsive">
            <table class="table">
                <tbody>
                    <tr>
                        <th style="width:35%;">Title</th>
                        <td><strong>{{ task.title }}</strong></td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>{{ task.description ?? 'N/A' }}</td>
                    </tr>
                    <tr>
                        <th>Priority</th>
                        <td>
                            <span class="badge {{ task.priority == 'High' ? 'badge-danger' : 'badge-info' }}">{{ task.priority ?? 'Normal' }}</span>
                        </td>
                    </tr>
                    <tr>
                        <th>Deadline</th>
                        <td>{{ task.deadline ?? 'N/A' }}</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td>
                            <span class="badge {{ task.status == 'Completed' ? 'badge-success' : 'badge-warning' }}">{{ task.status ?? 'Pending' }}</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div style="padding:16px 20px; text-align:right; border-top:1px solid var(--border-color);">
        <a href="{{ path('app_task_edit', {'id': task.id}) }}" class="btn btn-primary">
            <i class="fa-solid fa-pen"></i> Edit Task
        </a>
    </div>
</div>
{% endblock %}
