{% extends 'base.html.twig' %}

{% block title %}Edit Task — ERP Portal{% endblock %}
{% block page_heading %}Edit Task{% endblock %}

{% block body %}
<div class="card-panel" style="max-width:650px; margin:0 auto;">
    <div class="card-header-flex">
        <h2><i class="fa-solid fa-pen-to-square" style="margin-right:8px; color:var(--secondary);"></i> Edit Task #{{ task.id }}</h2>
        <a href="{{ path('app_task_index') }}" class="btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Back to List
        </a>
    </div>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        <div class="form-group">
            {{ form_label(form.title) }}
            {{ form_widget(form.title) }}
            {{ form_errors(form.title) }}
        </div>
        <div class="form-group">
            {{ form_label(form.description) }}
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
        </div>
        <div class="form-grid">
            <div class="form-group">
                {{ form_label(form.priority) }}
                {{ form_widget(form.priority) }}
                {{ form_errors(form.priority) }}
            </div>
            <div class="form-group">
                {{ form_label(form.status) }}
                {{ form_widget(form.status) }}
                {{ form_errors(form.status) }}
            </div>
            <div class="form-group">
                {{ form_label(form.deadline) }}
                {{ form_widget(form.deadline) }}
                {{ form_errors(form.deadline) }}
            </div>
        </div>

        <div style="margin-top:20px; display:flex; justify-content:space-between; align-items:center;">
            {% if is_granted('ROLE_ADMIN') %}
            {{ include('task/_delete_form.html.twig') }}
            {% else %}
            <div></div>
            {% endif %}
            <button type="submit" class="btn-primary">
                <i class="fa-solid fa-check"></i> Save Changes
            </button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
