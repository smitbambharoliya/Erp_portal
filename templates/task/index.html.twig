{% extends 'base.html.twig' %}

{% block title %}Tasks — CoreUI ERP Portal{% endblock %}
{% block page_heading %}Tasks{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">
        <h5><i class="fa-solid fa-list-check" style="margin-right:8px; color:var(--info);"></i> Task Assignments</h5>
        <a href="{{ path('app_task_new') }}" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Create Task
        </a>
    </div>
    <div class="card-body" style="padding:0;">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Task Title</th>
                        <th>Priority</th>
                        <th>Deadline</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for task in tasks %}
                    <tr>
                        <td><strong>#{{ task.id }}</strong></td>
                        <td>
                            <strong>{{ task.title }}</strong>
                            <div style="font-size:0.75rem; color:var(--text-mute);">{{ task.description|slice(0, 45) ~ '...' }}</div>
                        </td>
                        <td>
                            {% if task.priority == 'High' %}
                                <span class="badge badge-danger">High</span>
                            {% elseif task.priority == 'Medium' %}
                                <span class="badge badge-warning">Medium</span>
                            {% else %}
                                <span class="badge badge-info">Low</span>
                            {% endif %}
                        </td>
                        <td>{{ task.deadline ?? '-' }}</td>
                        <td>
                            <span class="badge {{ task.status == 'Completed' ? 'badge-success' : 'badge-warning' }}">
                                {{ task.status ?? 'Pending' }}
                            </span>
                        </td>
                        <td>
                            <a href="{{ path('app_task_show', {'id': task.id}) }}" class="btn btn-sm btn-secondary"><i class="fa-solid fa-eye"></i></a>
                            <a href="{{ path('app_task_edit', {'id': task.id}) }}" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" style="text-align:center; padding:40px; color:var(--text-mute);">
                            No tasks found.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
