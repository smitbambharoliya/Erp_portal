{% extends 'base.html.twig' %}

{% block title %}Super Admin Dashboard — ERP Portal{% endblock %}
{% block page_heading %}Super Admin Control Panel{% endblock %}

{% block body %}
<style>
    .adm-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 18px; margin-bottom: 24px; }
    .adm-card {
        border-radius: 12px; padding: 22px; color: #fff;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        position: relative; overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
        text-decoration: none; display: block;
    }
    .adm-card:hover { transform: translateY(-4px); box-shadow: 0 8px 25px rgba(0,0,0,0.14); }
    .adm-card .icon { font-size: 2.2rem; opacity: 0.25; position: absolute; right: 18px; top: 20px; }
    .adm-card .label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; opacity: 0.9; margin-bottom: 6px; }
    .adm-card .value { font-size: 2.2rem; font-weight: 800; line-height: 1.1; }
    .adm-card .sub { font-size: 0.78rem; opacity: 0.85; margin-top: 6px; }
    .c-purple { background: linear-gradient(135deg, #5856d6, #6366f1); }
    .c-green  { background: linear-gradient(135deg, #10b981, #059669); }
    .c-blue   { background: linear-gradient(135deg, #3b82f6, #2563eb); }
    .c-amber  { background: linear-gradient(135deg, #f59e0b, #d97706); }
    .c-red    { background: linear-gradient(135deg, #ef4444, #dc2626); }
    .c-indigo { background: linear-gradient(135deg, #8b5cf6, #7c3aed); }
    .c-teal   { background: linear-gradient(135deg, #14b8a6, #0d9488); }

    .adm-section { background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); margin-bottom: 24px; overflow: hidden; border: 1px solid #e2e8f0; }
    .adm-section-header { padding: 18px 22px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; background: #fff; }
    .adm-section-header h2 { font-size: 1rem; font-weight: 700; color: #1e293b; margin: 0; display: flex; align-items: center; gap: 10px; }
    .adm-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
    .adm-table th { padding: 12px 18px; background: #f8fafc; color: #64748b; font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; text-align: left; }
    .adm-table td { padding: 14px 18px; border-top: 1px solid #f1f5f9; color: #334155; }
    .adm-table tr:hover td { background: #f8fafc; }
    .badge-status { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; }
    .badge-warning { background: #fef3c7; color: #92400e; }
    .badge-success { background: #d1fae5; color: #065f46; }
    .badge-danger  { background: #fee2e2; color: #991b1b; }
    .badge-info    { background: #dbeafe; color: #1e40af; }
    .quick-btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 8px; font-size: 0.85rem; font-weight: 600; text-decoration: none; transition: all 0.15s ease; border: 1px solid transparent; }
    .quick-btn:hover { opacity: 0.9; transform: translateY(-1px); }
    .quick-grid { display: flex; flex-wrap: wrap; gap: 12px; padding: 22px; }
</style>

{# ─── Banner ─── #}
<div class="card mb-4" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 60%, #4c1d95 100%); border: none; border-radius: 12px; padding: 28px 32px; color: #ffffff; box-shadow: 0 8px 24px rgba(79,70,229,0.25);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="font-size: 0.8rem; color: rgba(255,255,255,0.7); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px;">
                <i class="fa-solid fa-shield-halved"></i> Super Admin Panel
            </div>
            <h2 style="font-weight: 800; font-size: 1.6rem; margin: 0 0 6px; color: #ffffff;">Welcome back, {{ app.user.email ?? 'Admin' }} 👋</h2>
            <p style="opacity: 0.85; margin: 0; font-size: 0.92rem;">
                Complete system administration & company-wide analytics — {{ "now"|date("D, d M Y") }}
            </p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <a href="{{ path('app_employee_new') }}" class="btn" style="background: #ffffff; color: #4f46e5; font-weight: 700; padding: 10px 18px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
                <i class="fa-solid fa-user-plus"></i> Add Employee
            </a>
            <a href="{{ path('app_leave_request_index') }}" class="btn" style="background: rgba(255,255,255,0.18); color: #ffffff; font-weight: 600; padding: 10px 18px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; border: 1px solid rgba(255,255,255,0.3);">
                <i class="fa-solid fa-calendar-check"></i> Leave Requests
            </a>
        </div>
    </div>
</div>

{# ─── Stats Grid ─── #}
<div class="adm-grid">
    <div class="adm-card c-purple">
        <i class="fa-solid fa-users icon"></i>
        <div class="label">Total Employees</div>
        <div class="value">{{ total_employees }}</div>
        <div class="sub">{{ active_employees }} active staff</div>
    </div>
    <div class="adm-card c-blue">
        <i class="fa-solid fa-user-gear icon"></i>
        <div class="label">Total Users</div>
        <div class="value">{{ total_users }}</div>
        <div class="sub">System user accounts</div>
    </div>
    <div class="adm-card c-green">
        <i class="fa-solid fa-building icon"></i>
        <div class="label">Departments</div>
        <div class="value">{{ total_departments }}</div>
        <div class="sub">Active company divisions</div>
    </div>
    <div class="adm-card c-indigo">
        <i class="fa-solid fa-diagram-project icon"></i>
        <div class="label">Projects</div>
        <div class="value">{{ total_projects }}</div>
        <div class="sub">{{ total_tasks }} active tasks</div>
    </div>
    <div class="adm-card c-amber">
        <i class="fa-solid fa-calendar-xmark icon"></i>
        <div class="label">Pending Leaves</div>
        <div class="value">{{ pending_leaves }}</div>
        <div class="sub">Applications awaiting review</div>
    </div>
    <div class="adm-card c-teal">
        <i class="fa-solid fa-fingerprint icon"></i>
        <div class="label">Today's Attendance</div>
        <div class="value">{{ today_attendance }}</div>
        <div class="sub">Checked in today</div>
    </div>
</div>

{# ─── Two-column layout ─── #}
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 24px; margin-bottom: 24px;">

    {# Pending Leaves Table #}
    <div class="adm-section">
        <div class="adm-section-header">
            <h2><i class="fa-solid fa-clock-rotate-left" style="color:#f59e0b;"></i> Pending Leave Applications</h2>
            <a href="{{ path('app_leave_request_index') }}" class="btn btn-sm btn-outline-primary" style="border-radius:6px; font-weight:600;">View All</a>
        </div>
        <div style="overflow-x:auto;">
            <table class="adm-table">
                <thead><tr>
                    <th>Employee</th>
                    <th>Leave Type</th>
                    <th>Status</th>
                </tr></thead>
                <tbody>
                {% for leave in recent_leaves %}
                    <tr>
                        <td><strong>{{ leave.employee ? leave.employee.firstName ~ ' ' ~ leave.employee.lastName : 'N/A' }}</strong></td>
                        <td><span class="badge-status badge-info">{{ leave.leaveType ?? 'Casual Leave' }}</span></td>
                        <td><span class="badge-status badge-warning">Pending</span></td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" style="text-align:center; color:#94a3b8; padding:30px;">No pending leave applications.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Recent Employees Table #}
    <div class="adm-section">
        <div class="adm-section-header">
            <h2><i class="fa-solid fa-user-check" style="color:#10b981;"></i> Recently Onboarded Staff</h2>
            <a href="{{ path('app_employee_index') }}" class="btn btn-sm btn-outline-primary" style="border-radius:6px; font-weight:600;">View All</a>
        </div>
        <div style="overflow-x:auto;">
            <table class="adm-table">
                <thead><tr>
                    <th>Employee Name</th>
                    <th>Department</th>
                    <th>Status</th>
                </tr></thead>
                <tbody>
                {% for emp in recent_employees %}
                    <tr>
                        <td><strong>{{ emp.firstName }} {{ emp.lastName }}</strong></td>
                        <td>{{ emp.department ? emp.department.name : 'N/A' }}</td>
                        <td>
                            {% if emp.status == 'Active' %}
                                <span class="badge-status badge-success">Active</span>
                            {% else %}
                                <span class="badge-status badge-danger">{{ emp.status ?? 'Inactive' }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" style="text-align:center; color:#94a3b8; padding:30px;">No employees registered yet.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{# ─── Quick Actions ─── #}
<div class="adm-section">
    <div class="adm-section-header">
        <h2><i class="fa-solid fa-bolt" style="color:#f59e0b;"></i> Quick System Operations</h2>
    </div>
    <div class="quick-grid">
        <a href="{{ path('app_employee_new') }}" class="quick-btn" style="background:#ede9fe; color:#5856d6; border-color:#ddd6fe;">
            <i class="fa-solid fa-user-plus"></i> Onboard Employee
        </a>
        <a href="{{ path('app_user_index') }}" class="quick-btn" style="background:#dbeafe; color:#2563eb; border-color:#bfdbfe;">
            <i class="fa-solid fa-users-gear"></i> Manage User Accounts
        </a>
        <a href="{{ path('app_department_new') }}" class="quick-btn" style="background:#d1fae5; color:#065f46; border-color:#a7f3d0;">
            <i class="fa-solid fa-sitemap"></i> Add Department
        </a>
        <a href="{{ path('app_project_index') }}" class="quick-btn" style="background:#fef3c7; color:#92400e; border-color:#fde68a;">
            <i class="fa-solid fa-diagram-project"></i> Project Management
        </a>
        <a href="{{ path('app_salary_index') }}" class="quick-btn" style="background:#fee2e2; color:#991b1b; border-color:#fca5a5;">
            <i class="fa-solid fa-wallet"></i> Manage Salaries
        </a>
        <a href="{{ path('app_attendance_index') }}" class="quick-btn" style="background:#f3e8ff; color:#7c3aed; border-color:#e9d5ff;">
            <i class="fa-solid fa-calendar-check"></i> Attendance Log
        </a>
        <a href="{{ path('app_register') }}" class="quick-btn" style="background:#e0f2fe; color:#0369a1; border-color:#bae6fd;">
            <i class="fa-solid fa-user-shield"></i> Register New User
        </a>
    </div>
</div>
{% endblock %}
