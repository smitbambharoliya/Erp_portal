{% extends 'base.html.twig' %}

{% block title %}ERP Portal — Dashboard{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
        --primary:   #6366f1;
        --primary-d: #4f46e5;
        --secondary: #0ea5e9;
        --success:   #10b981;
        --warning:   #f59e0b;
        --danger:    #ef4444;
        --dark:      #0f172a;
        --dark-mid:  #1e293b;
        --dark-soft: #334155;
        --text-main: #f8fafc;
        --text-mute: #94a3b8;
        --card-bg:   rgba(30,41,59,0.85);
        --border:    rgba(99,102,241,0.18);
        --glass:     rgba(255,255,255,0.05);
    }

    body {
        font-family: 'Inter', sans-serif;
        background: var(--dark);
        color: var(--text-main);
        min-height: 100vh;
        display: flex;
        overflow: hidden;
    }

    /* ───── ANIMATED BACKGROUND ───── */
    body::before {
        content: '';
        position: fixed; inset: 0; z-index: 0;
        background: radial-gradient(ellipse 80% 60% at 20% 10%, rgba(99,102,241,0.18) 0%, transparent 60%),
                    radial-gradient(ellipse 60% 50% at 80% 90%, rgba(14,165,233,0.12) 0%, transparent 60%);
        pointer-events: none;
    }

    /* ───── SIDEBAR ───── */
    .sidebar {
        width: 260px;
        min-height: 100vh;
        background: rgba(15,23,42,0.96);
        backdrop-filter: blur(20px);
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        position: fixed; left: 0; top: 0; bottom: 0;
        z-index: 100;
        transition: width 0.3s ease;
    }

    .sidebar-logo {
        padding: 28px 24px 24px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .logo-icon {
        width: 44px; height: 44px;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem;
        box-shadow: 0 0 20px rgba(99,102,241,0.4);
        flex-shrink: 0;
    }

    .logo-text { display: flex; flex-direction: column; }
    .logo-text strong { font-size: 1rem; font-weight: 700; letter-spacing: 0.5px; }
    .logo-text span   { font-size: 0.72rem; color: var(--text-mute); font-weight: 400; }

    .sidebar-nav { padding: 20px 12px; flex: 1; overflow-y: auto; }

    .nav-section-title {
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: var(--text-mute);
        padding: 10px 12px 6px;
        margin-top: 8px;
    }

    .nav-link {
        display: flex; align-items: center; gap: 12px;
        padding: 11px 14px;
        border-radius: 10px;
        text-decoration: none;
        color: var(--text-mute);
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.2s ease;
        margin-bottom: 2px;
        position: relative;
    }
    .nav-link:hover {
        background: var(--glass);
        color: var(--text-main);
        transform: translateX(3px);
    }
    .nav-link.active {
        background: rgba(99,102,241,0.18);
        color: var(--primary);
        border-left: 3px solid var(--primary);
        padding-left: 11px;
    }
    .nav-link i { width: 18px; text-align: center; font-size: 0.9rem; }

    .sidebar-footer {
        padding: 16px 12px;
        border-top: 1px solid var(--border);
    }

    .user-card {
        display: flex; align-items: center; gap: 12px;
        padding: 12px;
        border-radius: 12px;
        background: var(--glass);
        border: 1px solid var(--border);
    }
    .user-avatar {
        width: 38px; height: 38px;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 0.9rem;
        flex-shrink: 0;
    }
    .user-info strong { display: block; font-size: 0.82rem; font-weight: 600; }
    .user-info span   { font-size: 0.72rem; color: var(--text-mute); }

    /* ───── MAIN CONTENT ───── */
    .main {
        margin-left: 260px;
        flex: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        position: relative; z-index: 1;
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* ───── TOP BAR ───── */
    .topbar {
        padding: 20px 32px;
        display: flex; align-items: center; justify-content: space-between;
        background: rgba(15,23,42,0.6);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
        position: sticky; top: 0; z-index: 50;
    }

    .topbar-left h1 { font-size: 1.35rem; font-weight: 700; }
    .topbar-left p  { font-size: 0.8rem; color: var(--text-mute); margin-top: 2px; }

    .topbar-right { display: flex; align-items: center; gap: 16px; }

    .topbar-icon-btn {
        width: 38px; height: 38px;
        background: var(--glass);
        border: 1px solid var(--border);
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer;
        color: var(--text-mute);
        transition: all 0.2s;
        text-decoration: none;
        font-size: 0.85rem;
    }
    .topbar-icon-btn:hover { color: var(--text-main); background: rgba(99,102,241,0.15); }

    .logout-btn {
        display: flex; align-items: center; gap: 8px;
        padding: 9px 18px;
        background: rgba(239,68,68,0.12);
        border: 1px solid rgba(239,68,68,0.3);
        border-radius: 10px;
        color: #f87171;
        text-decoration: none;
        font-size: 0.82rem;
        font-weight: 500;
        transition: all 0.2s;
    }
    .logout-btn:hover { background: rgba(239,68,68,0.25); color: #fca5a5; }

    /* ───── PAGE CONTENT ───── */
    .content { padding: 28px 32px; }

    /* ───── GREETING BANNER ───── */
    .greeting-banner {
        background: linear-gradient(135deg, rgba(99,102,241,0.25) 0%, rgba(14,165,233,0.15) 100%);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 28px 32px;
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 28px;
        position: relative;
        overflow: hidden;
    }
    .greeting-banner::before {
        content: '';
        position: absolute; top: -40px; right: -40px;
        width: 160px; height: 160px;
        background: radial-gradient(circle, rgba(99,102,241,0.3) 0%, transparent 70%);
        border-radius: 50%;
    }
    .greeting-text h2 { font-size: 1.6rem; font-weight: 700; }
    .greeting-text p  { color: var(--text-mute); font-size: 0.9rem; margin-top: 5px; }
    .greeting-emoji   { font-size: 3.5rem; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3)); }

    /* ───── STATS GRID ───── */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 28px;
    }

    .stat-card {
        background: var(--card-bg);
        backdrop-filter: blur(12px);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 22px;
        position: relative;
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    }
    .stat-card::after {
        content: '';
        position: absolute; top: 0; left: 0; right: 0;
        height: 2px;
    }
    .stat-card.blue::after   { background: linear-gradient(90deg, var(--primary), var(--secondary)); }
    .stat-card.green::after  { background: linear-gradient(90deg, var(--success), #34d399); }
    .stat-card.yellow::after { background: linear-gradient(90deg, var(--warning), #fcd34d); }
    .stat-card.red::after    { background: linear-gradient(90deg, var(--danger), #f87171); }

    .stat-icon {
        width: 46px; height: 46px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem;
        margin-bottom: 14px;
    }
    .blue .stat-icon   { background: rgba(99,102,241,0.2);  color: #818cf8; }
    .green .stat-icon  { background: rgba(16,185,129,0.2);  color: #34d399; }
    .yellow .stat-icon { background: rgba(245,158,11,0.2);  color: #fcd34d; }
    .red .stat-icon    { background: rgba(239,68,68,0.2);   color: #f87171; }

    .stat-value { font-size: 1.9rem; font-weight: 800; line-height: 1; margin-bottom: 4px; }
    .stat-label { font-size: 0.8rem; color: var(--text-mute); font-weight: 500; }

    /* ───── MODULES GRID ───── */
    .section-title {
        font-size: 1rem; font-weight: 700;
        margin-bottom: 18px;
        display: flex; align-items: center; gap: 10px;
    }
    .section-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border);
    }

    .modules-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }

    .module-card {
        background: var(--card-bg);
        backdrop-filter: blur(12px);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 24px 20px;
        text-align: center;
        text-decoration: none;
        color: var(--text-main);
        transition: all 0.25s ease;
        display: block;
        position: relative;
        overflow: hidden;
    }
    .module-card::before {
        content: '';
        position: absolute; inset: 0;
        background: linear-gradient(135deg, transparent 60%, rgba(99,102,241,0.08) 100%);
        opacity: 0;
        transition: opacity 0.3s;
    }
    .module-card:hover { transform: translateY(-5px); box-shadow: 0 16px 40px rgba(0,0,0,0.35); border-color: rgba(99,102,241,0.4); }
    .module-card:hover::before { opacity: 1; }

    .module-icon {
        width: 56px; height: 56px;
        border-radius: 16px;
        margin: 0 auto 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem;
        transition: transform 0.25s;
    }
    .module-card:hover .module-icon { transform: scale(1.1) rotate(-5deg); }

    .module-label { font-size: 0.82rem; font-weight: 600; color: var(--text-main); margin-bottom: 4px; }
    .module-sub   { font-size: 0.72rem; color: var(--text-mute); }

    /* Module color variants */
    .m-indigo  .module-icon { background: rgba(99,102,241,0.2); color: #818cf8; }
    .m-sky     .module-icon { background: rgba(14,165,233,0.2); color: #38bdf8; }
    .m-emerald .module-icon { background: rgba(16,185,129,0.2); color: #34d399; }
    .m-amber   .module-icon { background: rgba(245,158,11,0.2); color: #fcd34d; }
    .m-rose    .module-icon { background: rgba(244,63,94,0.2);  color: #fb7185; }
    .m-violet  .module-icon { background: rgba(139,92,246,0.2); color: #a78bfa; }
    .m-teal    .module-icon { background: rgba(20,184,166,0.2); color: #2dd4bf; }
    .m-orange  .module-icon { background: rgba(249,115,22,0.2); color: #fb923c; }

    /* ───── FOOTER ───── */
    .page-footer {
        padding: 20px 32px;
        border-top: 1px solid var(--border);
        font-size: 0.75rem;
        color: var(--text-mute);
        text-align: center;
        margin-top: auto;
    }

    /* ───── ANIMATIONS ───── */
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .animate-1 { animation: fadeUp 0.5s ease both; }
    .animate-2 { animation: fadeUp 0.5s 0.1s ease both; }
    .animate-3 { animation: fadeUp 0.5s 0.2s ease both; }
    .animate-4 { animation: fadeUp 0.5s 0.3s ease both; }
    .animate-5 { animation: fadeUp 0.5s 0.4s ease both; }

    /* ───── SCROLLBAR ───── */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--dark-soft); border-radius: 3px; }
</style>
{% endblock %}

{% block body %}

{# ─────────────────── SIDEBAR ─────────────────── #}
<aside class="sidebar">
    <div class="sidebar-logo">
        <div class="logo-icon">⚡</div>
        <div class="logo-text">
            <strong>ERP Portal</strong>
            <span>Enterprise Management</span>
        </div>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-section-title">Main</div>
        <a href="{{ path('app_usedashboard') }}" class="nav-link active">
            <i class="fa-solid fa-house-chimney"></i> Dashboard
        </a>
        <a href="{{ path('app_employee_index') }}" class="nav-link">
            <i class="fa-solid fa-users"></i> Employees
        </a>
        <a href="{{ path('app_department_index') }}" class="nav-link">
            <i class="fa-solid fa-building"></i> Departments
        </a>

        <div class="nav-section-title">HR</div>
        <a href="{{ path('app_attendance_index') }}" class="nav-link">
            <i class="fa-solid fa-calendar-check"></i> Attendance
        </a>
        <a href="{{ path('app_leave_request_index') }}" class="nav-link">
            <i class="fa-solid fa-plane-departure"></i> Leave Requests
        </a>
        <a href="{{ path('app_salary_index') }}" class="nav-link">
            <i class="fa-solid fa-money-bill-wave"></i> Salary
        </a>

        <div class="nav-section-title">Projects</div>
        <a href="{{ path('app_project_index') }}" class="nav-link">
            <i class="fa-solid fa-diagram-project"></i> Projects
        </a>
        <a href="{{ path('app_task_index') }}" class="nav-link">
            <i class="fa-solid fa-list-check"></i> Tasks
        </a>

        <div class="nav-section-title">Account</div>
        <a href="{{ path('app_register') }}" class="nav-link">
            <i class="fa-solid fa-user-plus"></i> Register User
        </a>
    </nav>

    <div class="sidebar-footer">
        <div class="user-card">
            <div class="user-avatar">
                {{ app.user ? app.user.email|slice(0,1)|upper : '?' }}
            </div>
            <div class="user-info">
                <strong>
                    {% if employee %}
                        {{ employee.firstName }} {{ employee.lastName }}
                    {% else %}
                        {{ app.user ? app.user.email : 'User' }}
                    {% endif %}
                </strong>
                <span>{{ app.user.roles|join(', ')|replace({'ROLE_': '', '_': ' '})|lower|capitalize }}</span>
            </div>
        </div>
    </div>
</aside>

{# ─────────────────── MAIN ─────────────────── #}
<div class="main">

    {# TOP BAR #}
    <header class="topbar">
        <div class="topbar-left">
            <h1>Dashboard</h1>
            <p>{{ "now"|date("l, d F Y") }} — Welcome back!</p>
        </div>
        <div class="topbar-right">
            <a href="{{ path('app_employee_index') }}" class="topbar-icon-btn" title="Employees">
                <i class="fa-solid fa-users"></i>
            </a>
            <a href="{{ path('app_attendance_index') }}" class="topbar-icon-btn" title="Attendance">
                <i class="fa-solid fa-calendar-check"></i>
            </a>
            <a href="{{ path('app_logout') }}" class="logout-btn">
                <i class="fa-solid fa-right-from-bracket"></i> Logout
            </a>
        </div>
    </header>

    {# PAGE CONTENT #}
    <div class="content">

        {# ── GREETING BANNER ── #}
        <div class="greeting-banner animate-1">
            <div class="greeting-text">
                <h2>
                    Good {% if "now"|date("H") < 12 %}Morning{% elseif "now"|date("H") < 17 %}Afternoon{% else %}Evening{% endif %},
                    {% if employee %}
                        {{ employee.firstName }}! 👋
                    {% else %}
                        {{ app.user ? app.user.email : 'User' }}! 👋
                    {% endif %}
                </h2>
                <p>Here is your ERP portal overview for today.</p>
                {% if employee %}
                <p style="margin-top:8px; font-size:0.82rem; color:#818cf8;">
                    <i class="fa-solid fa-id-badge" style="margin-right:6px;"></i>
                    {{ employee.designation ?? 'Employee' }}
                    {% if employee.department %}
                        &nbsp;·&nbsp; <i class="fa-solid fa-building" style="margin-right:4px;"></i>{{ employee.department.name }}
                    {% endif %}
                </p>
                {% endif %}
            </div>
            <div class="greeting-emoji">🚀</div>
        </div>

        {# ── STATS CARDS ── #}
        <div class="stats-grid animate-2">
            <div class="stat-card blue">
                <div class="stat-icon"><i class="fa-solid fa-users"></i></div>
                <div class="stat-value">—</div>
                <div class="stat-label">Total Employees</div>
            </div>
            <div class="stat-card green">
                <div class="stat-icon"><i class="fa-solid fa-building"></i></div>
                <div class="stat-value">—</div>
                <div class="stat-label">Departments</div>
            </div>
            <div class="stat-card yellow">
                <div class="stat-icon"><i class="fa-solid fa-diagram-project"></i></div>
                <div class="stat-value">—</div>
                <div class="stat-label">Active Projects</div>
            </div>
            <div class="stat-card red">
                <div class="stat-icon"><i class="fa-solid fa-plane-departure"></i></div>
                <div class="stat-value">—</div>
                <div class="stat-label">Leave Requests</div>
            </div>
        </div>

        {# ── MODULES GRID ── #}
        <div class="section-title animate-3">Quick Access</div>
        <div class="modules-grid animate-4">

            <a href="{{ path('app_employee_index') }}" class="module-card m-indigo">
                <div class="module-icon"><i class="fa-solid fa-users"></i></div>
                <div class="module-label">Employees</div>
                <div class="module-sub">Manage staff</div>
            </a>

            <a href="{{ path('app_department_index') }}" class="module-card m-sky">
                <div class="module-icon"><i class="fa-solid fa-building"></i></div>
                <div class="module-label">Departments</div>
                <div class="module-sub">Org structure</div>
            </a>

            <a href="{{ path('app_attendance_index') }}" class="module-card m-emerald">
                <div class="module-icon"><i class="fa-solid fa-calendar-check"></i></div>
                <div class="module-label">Attendance</div>
                <div class="module-sub">Track presence</div>
            </a>

            <a href="{{ path('app_leave_request_index') }}" class="module-card m-amber">
                <div class="module-icon"><i class="fa-solid fa-plane-departure"></i></div>
                <div class="module-label">Leave</div>
                <div class="module-sub">Manage leaves</div>
            </a>

            <a href="{{ path('app_salary_index') }}" class="module-card m-rose">
                <div class="module-icon"><i class="fa-solid fa-money-bill-wave"></i></div>
                <div class="module-label">Salary</div>
                <div class="module-sub">Payroll & slips</div>
            </a>

            <a href="{{ path('app_project_index') }}" class="module-card m-violet">
                <div class="module-icon"><i class="fa-solid fa-diagram-project"></i></div>
                <div class="module-label">Projects</div>
                <div class="module-sub">All projects</div>
            </a>

            <a href="{{ path('app_task_index') }}" class="module-card m-teal">
                <div class="module-icon"><i class="fa-solid fa-list-check"></i></div>
                <div class="module-label">Tasks</div>
                <div class="module-sub">Track tasks</div>
            </a>

            <a href="{{ path('app_register') }}" class="module-card m-orange">
                <div class="module-icon"><i class="fa-solid fa-user-plus"></i></div>
                <div class="module-label">Add User</div>
                <div class="module-sub">Register account</div>
            </a>

        </div>

        {# ── EMPLOYEE DETAILS CARD (if employee profile exists) ── #}
        {% if employee %}
        <div class="section-title animate-5">My Profile</div>
        <div class="stat-card blue animate-5" style="padding: 24px 28px; border-radius: 16px; display: flex; gap: 24px; align-items: center; flex-wrap: wrap;">
            <div style="width: 64px; height: 64px; background: linear-gradient(135deg, var(--primary), var(--secondary)); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; font-weight: 800; flex-shrink: 0;">
                {{ employee.firstName|slice(0,1)|upper }}
            </div>
            <div style="flex: 1; min-width: 180px;">
                <div style="font-size: 1.1rem; font-weight: 700;">{{ employee.firstName }} {{ employee.lastName }}</div>
                <div style="font-size: 0.82rem; color: var(--text-mute); margin-top: 4px;">
                    {{ employee.designation ?? 'Employee' }}
                    {% if employee.department %} · {{ employee.department.name }}{% endif %}
                </div>
                <div style="display: flex; gap: 20px; flex-wrap: wrap; margin-top: 12px; font-size: 0.8rem; color: var(--text-mute);">
                    {% if employee.phone %}<span><i class="fa-solid fa-phone" style="margin-right:5px; color:#818cf8;"></i>{{ employee.phone }}</span>{% endif %}
                    {% if employee.joiningDate %}<span><i class="fa-solid fa-calendar" style="margin-right:5px; color:#34d399;"></i>Joined: {{ employee.joiningDate }}</span>{% endif %}
                    {% if employee.status %}<span><i class="fa-solid fa-circle" style="margin-right:5px; color:#10b981; font-size:0.6rem;"></i>{{ employee.status }}</span>{% endif %}
                </div>
            </div>
            <div>
                <a href="{{ path('app_employee_show', {'id': employee.id}) }}" style="display:inline-flex; align-items:center; gap:8px; padding:9px 18px; background: rgba(99,102,241,0.15); border: 1px solid rgba(99,102,241,0.4); border-radius: 10px; color: #818cf8; text-decoration: none; font-size: 0.82rem; font-weight: 600; transition: all 0.2s;">
                    <i class="fa-solid fa-eye"></i> View Profile
                </a>
            </div>
        </div>
        {% endif %}

    </div>{# /content #}

    <footer class="page-footer">
        © {{ "now"|date("Y") }} ERP Portal — All rights reserved.
    </footer>
</div>

{% endblock %}
