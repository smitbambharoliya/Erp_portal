{% extends 'base.html.twig' %}

{% block title %}Dashboard — ERP Portal{% endblock %}
{% block page_heading %}Dashboard{% endblock %}

{% block body %}

{# ── COREUI STAT WIDGETS (Matching Screenshot) ── #}
<div class="widget-grid">
    <div class="widget-card purple">
        <i class="fa-solid fa-users widget-icon"></i>
        <div class="widget-title">Total Staff</div>
        <div class="widget-value">—</div>
        <div class="widget-sub"><i class="fa-solid fa-arrow-up"></i> Active Employees</div>
    </div>

    <div class="widget-card blue">
        <i class="fa-solid fa-sitemap widget-icon"></i>
        <div class="widget-title">Departments</div>
        <div class="widget-value">—</div>
        <div class="widget-sub"><i class="fa-solid fa-building"></i> Organization Units</div>
    </div>

    <div class="widget-card orange">
        <i class="fa-solid fa-diagram-project widget-icon"></i>
        <div class="widget-title">Active Projects</div>
        <div class="widget-value">—</div>
        <div class="widget-sub"><i class="fa-solid fa-list-check"></i> Ongoing Tasks</div>
    </div>

    <div class="widget-card red">
        <i class="fa-solid fa-plane-departure widget-icon"></i>
        <div class="widget-title">Leave Requests</div>
        <div class="widget-value">—</div>
        <div class="widget-sub"><i class="fa-solid fa-clock"></i> Pending Approval</div>
    </div>
</div>

{# ── WELCOME BANNER CARD ── #}
<div class="card" style="margin-bottom:24px;">
    <div class="card-body" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; background:linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);">
        <div>
            <h4 style="font-size:1.3rem; font-weight:700; color:var(--text-main); margin-bottom:4px;">
                Good {% if "now"|date("H") < 12 %}Morning{% elseif "now"|date("H") < 17 %}Afternoon{% else %}Evening{% endif %}, 
                {% if employee %}{{ employee.firstName }}{% else %}{{ app.user.email }}{% endif %}! 👋
            </h4>
            <p style="color:var(--text-mute); font-size:0.875rem;">
                Welcome to your ERP Portal CoreUI Dashboard overview.
            </p>
            {% if employee %}
            <div style="margin-top:10px; font-size:0.82rem; color:var(--primary); font-weight:600;">
                <i class="fa-solid fa-id-badge" style="margin-right:6px;"></i>{{ employee.designation ?? 'Employee' }}
                {% if employee.department %} · <i class="fa-solid fa-sitemap" style="margin-right:4px;"></i>{{ employee.department.name }}{% endif %}
            </div>
            {% endif %}
        </div>
        <div>
            <a href="{{ path('app_attendance_index') }}" class="btn btn-primary" style="margin-right:8px;">
                <i class="fa-solid fa-calendar-check"></i> Attendance Log
            </a>
            <a href="{{ path('app_leave_request_new') }}" class="btn btn-secondary">
                <i class="fa-solid fa-plane-departure"></i> Apply Leave
            </a>
        </div>
    </div>
</div>

{# ── QUICK MODULE ACCESS ── #}
<div class="card">
    <div class="card-header">
        <h5><i class="fa-solid fa-cubes" style="margin-right:8px; color:var(--primary);"></i> Core Operations</h5>
    </div>
    <div class="card-body">
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:16px;">
            
            <a href="{{ path('app_employee_index') }}" style="text-decoration:none;">
                <div style="background:#f8f9fa; border:1px solid var(--border-color); border-radius:8px; padding:20px; text-align:center; transition:all 0.2s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.borderColor='var(--primary)';" onmouseout="this.style.transform='none'; this.style.borderColor='var(--border-color)';">
                    <div style="width:44px; height:44px; background:#eef2ff; color:var(--primary); border-radius:10px; display:flex; align-items:center; justify-content:center; margin:0 auto 10px; font-size:1.2rem;">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <strong style="display:block; color:var(--text-main); font-size:0.875rem;">Employees</strong>
                    <span style="font-size:0.75rem; color:var(--text-mute);">Manage staff</span>
                </div>
            </a>

            <a href="{{ path('app_department_index') }}" style="text-decoration:none;">
                <div style="background:#f8f9fa; border:1px solid var(--border-color); border-radius:8px; padding:20px; text-align:center; transition:all 0.2s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.borderColor='var(--info)';" onmouseout="this.style.transform='none'; this.style.borderColor='var(--border-color)';">
                    <div style="width:44px; height:44px; background:#e0f2fe; color:var(--info); border-radius:10px; display:flex; align-items:center; justify-content:center; margin:0 auto 10px; font-size:1.2rem;">
                        <i class="fa-solid fa-sitemap"></i>
                    </div>
                    <strong style="display:block; color:var(--text-main); font-size:0.875rem;">Departments</strong>
                    <span style="font-size:0.75rem; color:var(--text-mute);">Org structure</span>
                </div>
            </a>

            <a href="{{ path('app_attendance_index') }}" style="text-decoration:none;">
                <div style="background:#f8f9fa; border:1px solid var(--border-color); border-radius:8px; padding:20px; text-align:center; transition:all 0.2s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.borderColor='var(--success)';" onmouseout="this.style.transform='none'; this.style.borderColor='var(--border-color)';">
                    <div style="width:44px; height:44px; background:#dcfce7; color:var(--success); border-radius:10px; display:flex; align-items:center; justify-content:center; margin:0 auto 10px; font-size:1.2rem;">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                    <strong style="display:block; color:var(--text-main); font-size:0.875rem;">Attendance</strong>
                    <span style="font-size:0.75rem; color:var(--text-mute);">Daily logs</span>
                </div>
            </a>

            <a href="{{ path('app_leave_request_index') }}" style="text-decoration:none;">
                <div style="background:#f8f9fa; border:1px solid var(--border-color); border-radius:8px; padding:20px; text-align:center; transition:all 0.2s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.borderColor='var(--warning)';" onmouseout="this.style.transform='none'; this.style.borderColor='var(--border-color)';">
                    <div style="width:44px; height:44px; background:#fef3c7; color:var(--warning); border-radius:10px; display:flex; align-items:center; justify-content:center; margin:0 auto 10px; font-size:1.2rem;">
                        <i class="fa-solid fa-plane-departure"></i>
                    </div>
                    <strong style="display:block; color:var(--text-main); font-size:0.875rem;">Leave Requests</strong>
                    <span style="font-size:0.75rem; color:var(--text-mute);">Approvals</span>
                </div>
            </a>

            <a href="{{ path('app_salary_index') }}" style="text-decoration:none;">
                <div style="background:#f8f9fa; border:1px solid var(--border-color); border-radius:8px; padding:20px; text-align:center; transition:all 0.2s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.borderColor='var(--danger)';" onmouseout="this.style.transform='none'; this.style.borderColor='var(--border-color)';">
                    <div style="width:44px; height:44px; background:#fee2e2; color:var(--danger); border-radius:10px; display:flex; align-items:center; justify-content:center; margin:0 auto 10px; font-size:1.2rem;">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                    <strong style="display:block; color:var(--text-main); font-size:0.875rem;">Salary Slips</strong>
                    <span style="font-size:0.75rem; color:var(--text-mute);">Payroll</span>
                </div>
            </a>

            <a href="{{ path('app_project_index') }}" style="text-decoration:none;">
                <div style="background:#f8f9fa; border:1px solid var(--border-color); border-radius:8px; padding:20px; text-align:center; transition:all 0.2s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.borderColor='var(--primary)';" onmouseout="this.style.transform='none'; this.style.borderColor='var(--border-color)';">
                    <div style="width:44px; height:44px; background:#eef2ff; color:var(--primary); border-radius:10px; display:flex; align-items:center; justify-content:center; margin:0 auto 10px; font-size:1.2rem;">
                        <i class="fa-solid fa-diagram-project"></i>
                    </div>
                    <strong style="display:block; color:var(--text-main); font-size:0.875rem;">Projects</strong>
                    <span style="font-size:0.75rem; color:var(--text-mute);">Projects</span>
                </div>
            </a>

            <a href="{{ path('app_task_index') }}" style="text-decoration:none;">
                <div style="background:#f8f9fa; border:1px solid var(--border-color); border-radius:8px; padding:20px; text-align:center; transition:all 0.2s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.borderColor='var(--info)';" onmouseout="this.style.transform='none'; this.style.borderColor='var(--border-color)';">
                    <div style="width:44px; height:44px; background:#e0f2fe; color:var(--info); border-radius:10px; display:flex; align-items:center; justify-content:center; margin:0 auto 10px; font-size:1.2rem;">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                    <strong style="display:block; color:var(--text-main); font-size:0.875rem;">Tasks</strong>
                    <span style="font-size:0.75rem; color:var(--text-mute);">Assignments</span>
                </div>
            </a>

        </div>
    </div>
</div>

{# ── MY PROFILE CARD (If employee profile linked) ── #}
{% if employee %}
<div class="card">
    <div class="card-header">
        <h5><i class="fa-solid fa-id-card" style="margin-right:8px; color:var(--primary);"></i> My Employee Profile</h5>
    </div>
    <div class="card-body" style="display:flex; align-items:center; gap:20px; flex-wrap:wrap;">
        <div style="width:54px; height:54px; background-color:var(--primary); color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:1.3rem;">
            {{ employee.firstName|slice(0,1)|upper }}
        </div>
        <div style="flex:1;">
            <strong style="font-size:1rem; color:var(--text-main);">{{ employee.firstName }} {{ employee.lastName }}</strong>
            <div style="font-size:0.83rem; color:var(--text-mute); margin-top:2px;">
                {{ employee.designation ?? 'Employee' }} {% if employee.department %} · {{ employee.department.name }}{% endif %}
            </div>
            <div style="display:flex; gap:16px; margin-top:8px; font-size:0.8rem; color:var(--text-mute);">
                {% if employee.phone %}<span><i class="fa-solid fa-phone" style="margin-right:4px;"></i>{{ employee.phone }}</span>{% endif %}
                {% if employee.joiningDate %}<span><i class="fa-solid fa-calendar" style="margin-right:4px;"></i>Joined: {{ employee.joiningDate }}</span>{% endif %}
            </div>
        </div>
        <a href="{{ path('app_employee_show', {'id': employee.id}) }}" class="btn btn-outline-primary">
            <i class="fa-solid fa-eye"></i> View Profile
        </a>
    </div>
</div>
{% endif %}

{% endblock %}
