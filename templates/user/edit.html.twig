{% extends 'base.html.twig' %}

{% block title %}Edit User {{ user.email }} — CoreUI ERP Portal{% endblock %}
{% block page_heading %}Edit User Account{% endblock %}

{% block body %}
<div class="card" style="max-width:700px; margin:0 auto;">
    <div class="card-header">
        <h5><i class="fa-solid fa-user-pen" style="margin-right:8px; color:var(--primary);"></i> Edit Account: {{ user.email }}</h5>
        <a href="{{ path('app_user_index') }}" class="btn btn-secondary btn-sm">
            <i class="fa-solid fa-arrow-left"></i> Back to Users List
        </a>
    </div>

    <div class="card-body">
        {% if user.profilePic %}
        <div style="text-align:center; margin-bottom:20px;">
            <img src="{{ asset('uploads/profile_pics/' ~ user.profilePic) }}" alt="Profile Picture" style="width:90px; height:90px; border-radius:50%; object-fit:cover; border:3px solid var(--primary);">
        </div>
        {% endif %}

        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}
            <div class="form-group mb-3">
                {{ form_label(form.email) }}
                {{ form_widget(form.email) }}
                {{ form_errors(form.email) }}
            </div>

            <div class="form-group mb-3">
                {{ form_label(form.plainPassword) }}
                {{ form_widget(form.plainPassword) }}
                <div style="font-size:0.8rem; color:var(--text-mute); margin-top:4px;">Leave blank if you don't want to change the password.</div>
                {{ form_errors(form.plainPassword) }}
            </div>

            <div class="form-group mb-3">
                {{ form_label(form.role) }}
                {{ form_widget(form.role) }}
                {{ form_errors(form.role) }}
            </div>

            <div class="form-group mb-3">
                {{ form_label(form.profilePicFile) }}
                {{ form_widget(form.profilePicFile) }}
                <div style="font-size:0.8rem; color:var(--text-mute); margin-top:4px;">Upload new image to replace current profile picture.</div>
                {{ form_errors(form.profilePicFile) }}
            </div>

            <div style="margin-top:24px; display:flex; justify-content:space-between; align-items:center;">
                {% if is_granted('ROLE_HR') %}
                {{ include('user/_delete_form.html.twig') }}
                {% else %}
                <div></div>
                {% endif %}
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i> Save Changes
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
