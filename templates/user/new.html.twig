{% extends 'base.html.twig' %}

{% block title %}Create User Account — CoreUI ERP Portal{% endblock %}
{% block page_heading %}Create User Account{% endblock %}

{% block body %}
<div class="card" style="max-width:700px; margin:0 auto;">
    <div class="card-header">
        <h5><i class="fa-solid fa-user-plus" style="margin-right:8px; color:var(--primary);"></i> Add New User</h5>
        <a href="{{ path('app_user_index') }}" class="btn btn-secondary btn-sm">
            <i class="fa-solid fa-arrow-left"></i> Back to Users List
        </a>
    </div>

    <div class="card-body">
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}
            <div class="form-group mb-3">
                {{ form_label(form.email) }}
                {{ form_widget(form.email) }}
                {{ form_errors(form.email) }}
            </div>

            <div class="form-group mb-3">
                {{ form_label(form.plainPassword) }}
                {{ form_widget(form.plainPassword) }}
                {{ form_errors(form.plainPassword) }}
            </div>

            <div class="form-group mb-3">
                {{ form_label(form.role) }}
                {{ form_widget(form.role) }}
                {{ form_errors(form.role) }}
            </div>

            <div class="form-group mb-3">
                {{ form_label(form.profilePicFile) }}
                {{ form_widget(form.profilePicFile) }}
                <div style="font-size:0.8rem; color:var(--text-mute); margin-top:4px;">Upload profile image (JPG, PNG, WebP format under 5MB).</div>
                {{ form_errors(form.profilePicFile) }}
            </div>

            <div style="margin-top:24px; text-align:right;">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i> Create User Account
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
