{% extends 'base.html.twig' %}

{% block title %}Sign In — CoreUI ERP Portal{% endblock %}

{% block stylesheets %}
<style>
    .auth-card-wrap {
        width: 100%; max-width: 420px; padding: 20px;
    }
    .auth-card {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        padding: 36px 32px;
    }
    .auth-logo { text-align: center; margin-bottom: 24px; }
    .auth-logo-icon {
        width: 48px; height: 48px; background: linear-gradient(135deg, var(--primary), var(--info));
        border-radius: 10px; color: white; display: inline-flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: 1.3rem; margin-bottom: 10px;
    }
    .auth-logo h2 { font-size: 1.3rem; font-weight: 700; color: var(--text-main); margin: 0; }
    .auth-logo p { font-size: 0.83rem; color: var(--text-mute); margin-top: 4px; }

    .btn-auth {
        width: 100%; padding: 11px; background-color: var(--primary); color: white;
        border: none; border-radius: 6px; font-weight: 600; font-size: 0.9rem;
        cursor: pointer; transition: background 0.15s; margin-top: 8px;
    }
    .btn-auth:hover { background-color: var(--primary-hover); }

    .auth-footer-link { text-align: center; margin-top: 20px; font-size: 0.83rem; color: var(--text-mute); }
    .auth-footer-link a { color: var(--primary); text-decoration: none; font-weight: 600; }
    .auth-footer-link a:hover { text-decoration: underline; }
</style>
{% endblock %}

{% block body %}
<div class="auth-card-wrap">
    <div class="auth-card">
        <div class="auth-logo">
            <div class="auth-logo-icon">C</div>
            <h2>CoreUI ERP Portal</h2>
            <p>Sign in to your account</p>
        </div>

        {% if error %}
            <div class="alert alert-danger">
                <i class="fa-solid fa-circle-exclamation"></i> {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% if app.user %}
            <div class="alert alert-warning">
                Logged in as {{ app.user.userIdentifier }}. <a href="{{ path('app_logout') }}">Logout</a>
            </div>
        {% endif %}

        <form method="post">
            <div class="form-group">
                <label for="inputEmail">Email Address</label>
                <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" placeholder="name@company.com" autocomplete="email" required autofocus>
            </div>

            <div class="form-group">
                <label for="inputPassword">Password</label>
                <input type="password" name="password" id="inputPassword" class="form-control" placeholder="Enter password" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group" style="display:flex; align-items:center; gap:8px;">
                <input type="checkbox" name="_remember_me" id="remember_me" style="accent-color:var(--primary);">
                <label for="remember_me" style="margin:0; font-weight:400; font-size:0.83rem; cursor:pointer;">Remember me</label>
            </div>

            <button class="btn-auth" type="submit">
                <i class="fa-solid fa-right-to-bracket" style="margin-right:6px;"></i> Sign In
            </button>
        </form>

        <div class="auth-footer-link">
            Need an account? <a href="{{ path('app_register') }}">Register here</a>
        </div>
    </div>
</div>
{% endblock %}
