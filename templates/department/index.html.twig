{% extends 'base.html.twig' %}

{% block title %}Departments — CoreUI ERP Portal{% endblock %}
{% block page_heading %}Departments{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">
        <h5><i class="fa-solid fa-sitemap" style="margin-right:8px; color:var(--info);"></i> Department Directory</h5>
        {% if is_granted('ROLE_HR') %}
        <a href="{{ path('app_department_new') }}" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Add Department
        </a>
        {% endif %}
    </div>
    <div class="card-body" style="padding:0;">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Department Name</th>
                        <th>Description</th>
                        <th>Total Staff</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for department in departments %}
                    <tr>
                        <td><strong>#{{ department.id }}</strong></td>
                        <td><strong>{{ department.name }}</strong></td>
                        <td>{{ department.description ?? 'No description' }}</td>
                        <td><span class="badge badge-info">{{ department.employees|length }} Members</span></td>
                        <td>
                            <a href="{{ path('app_department_show', {'id': department.id}) }}" class="btn btn-sm btn-secondary"><i class="fa-solid fa-eye"></i> View</a>
                            {% if is_granted('ROLE_HR') %}
                            <a href="{{ path('app_department_edit', {'id': department.id}) }}" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i> Edit</a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" style="text-align:center; padding:40px; color:var(--text-mute);">
                            No department records found.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
