{% extends 'base.html.twig' %}

{% block title %}Employee Dashboard — CoreUI ERP Portal{% endblock %}
{% block page_heading %}Employee Dashboard{% endblock %}

{% block body %}
{# Profile Header & Summary Card #}
<div class="card mb-4" style="background: linear-gradient(135deg, #5856d6 0%, #39f 100%); color: #ffffff; border: none; border-radius: 12px; box-shadow: 0 4px 15px rgba(88,86,214,0.25);">
    <div class="card-body" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
            <div>
                <h3 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 6px;">
                    <i class="fa-solid fa-user-circle" style="margin-right: 8px;"></i>
                    {% if employee %}
                        Welcome, {{ employee.firstName }} {{ employee.lastName }}
                    {% else %}
                        Welcome, {{ app.user.email }}
                    {% endif %}
                </h3>
                <p style="opacity: 0.9; margin: 0; font-size: 0.95rem;">
                    {% if employee %}
                        <i class="fa-solid fa-briefcase" style="margin-right: 5px;"></i> {{ employee.designation ?? 'Employee' }} 
                        {% if employee.department %}
                            &bull; <i class="fa-solid fa-building" style="margin-right: 5px;"></i> {{ employee.department.name }}
                        {% endif %}
                    {% else %}
                        Employee Profile Pending
                    {% endif %}
                </p>
            </div>
            <div>
                <a href="{{ path('app_leave_request_new') }}" class="btn" style="background: #ffffff; color: var(--primary); font-weight: 600; padding: 10px 18px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
                    <i class="fa-solid fa-plus-circle"></i> Apply for Leave
                </a>
            </div>
        </div>
    </div>
</div>

{# Stat Cards Grid #}
<div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px;">
    <div class="card" style="border-left: 4px solid var(--primary);">
        <div class="card-body" style="padding: 20px;">
            <div style="font-size: 0.85rem; color: var(--text-mute); font-weight: 600; text-transform: uppercase;">Total Leave Requests</div>
            <div style="font-size: 1.8rem; font-weight: 700; color: var(--primary); margin-top: 5px;">{{ leaveRequests|length }}</div>
        </div>
    </div>
    
    <div class="card" style="border-left: 4px solid var(--warning);">
        <div class="card-body" style="padding: 20px;">
            <div style="font-size: 0.85rem; color: var(--text-mute); font-weight: 600; text-transform: uppercase;">Assigned Tasks</div>
            <div style="font-size: 1.8rem; font-weight: 700; color: var(--warning); margin-top: 5px;">{{ tasks|length }}</div>
        </div>
    </div>

    <div class="card" style="border-left: 4px solid var(--info);">
        <div class="card-body" style="padding: 20px;">
            <div style="font-size: 0.85rem; color: var(--text-mute); font-weight: 600; text-transform: uppercase;">Projects</div>
            <div style="font-size: 1.8rem; font-weight: 700; color: var(--info); margin-top: 5px;">{{ projects|length }}</div>
        </div>
    </div>

    <div class="card" style="border-left: 4px solid var(--success);">
        <div class="card-body" style="padding: 20px;">
            <div style="font-size: 0.85rem; color: var(--text-mute); font-weight: 600; text-transform: uppercase;">Attendance Records</div>
            <div style="font-size: 1.8rem; font-weight: 700; color: var(--success); margin-top: 5px;">{{ attendances|length }}</div>
        </div>
    </div>
</div>

{# Content Grid: Leaves & Tasks #}
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 24px;">
    
    {# Leave Requests #}
    <div class="card">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h5><i class="fa-solid fa-plane-departure" style="color: var(--warning); margin-right: 8px;"></i> Recent Leave Requests</h5>
            <a href="{{ path('app_leave_request_index') }}" class="btn btn-sm btn-outline-primary">View All</a>
        </div>
        <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
                <table class="table" style="margin: 0;">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for leave in leaveRequests %}
                        <tr>
                            <td><strong>{{ leave.leaveType ?? 'Casual Leave' }}</strong></td>
                            <td>{{ leave.startDate ?? '-' }}</td>
                            <td>{{ leave.endDate ?? '-' }}</td>
                            <td>
                                {% if leave.status == 'Approved' %}
                                    <span class="badge badge-success">Approved</span>
                                {% elseif leave.status == 'Rejected' %}
                                    <span class="badge badge-danger">Rejected</span>
                                {% else %}
                                    <span class="badge badge-warning">Pending</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 25px; color: var(--text-mute);">
                                No leave requests submitted yet.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# Assigned Tasks #}
    <div class="card">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h5><i class="fa-solid fa-list-check" style="color: var(--primary); margin-right: 8px;"></i> Assigned Tasks</h5>
        </div>
        <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
                <table class="table" style="margin: 0;">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Priority</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for task in tasks %}
                        <tr>
                            <td><strong>{{ task.title }}</strong></td>
                            <td>
                                <span class="badge badge-info">{{ task.priority ?? 'Normal' }}</span>
                            </td>
                            <td>
                                <span class="badge badge-warning">{{ task.status }}</span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" style="text-align: center; padding: 25px; color: var(--text-mute);">
                                No tasks assigned to you right now.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}
