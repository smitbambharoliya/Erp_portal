{% extends 'base.html.twig' %}

{% block title %}My Workspace Dashboard — Employee Portal{% endblock %}
{% block page_heading %}Employee Personal Workspace{% endblock %}

{% block body %}
{# Employee Profile Header Banner #}
<div class="card mb-4" style="background: linear-gradient(135deg, #059669 0%, #0284c7 100%); color: #ffffff; border: none; border-radius: 12px; box-shadow: 0 4px 15px rgba(5,150,105,0.25);">
    <div class="card-body" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
            <div style="display:flex; align-items:center; gap:16px;">
                {% if employee and employee.user and employee.user.profilePic %}
                    <img src="{{ asset('uploads/profile_pics/' ~ employee.user.profilePic) }}" alt="Avatar" style="width:56px; height:56px; border-radius:50%; object-fit:cover; border:2px solid #ffffff;">
                {% else %}
                    <div style="width:56px; height:56px; border-radius:50%; background:rgba(255,255,255,0.2); color:#ffffff; display:inline-flex; align-items:center; justify-content:center; font-weight:800; font-size:1.4rem;">
                        {{ employee ? employee.firstName|first|upper : app.user.email|first|upper }}
                    </div>
                {% endif %}
                <div>
                    <h3 style="font-weight: 800; font-size: 1.5rem; margin-bottom: 4px;">
                        {% if employee %}
                            Welcome back, {{ employee.firstName }} {{ employee.lastName }}! 👋
                        {% else %}
                            Welcome, {{ app.user.email }}! 👋
                        {% endif %}
                    </h3>
                    <p style="opacity: 0.9; margin: 0; font-size: 0.92rem;">
                        {% if employee %}
                            <i class="fa-solid fa-briefcase" style="margin-right: 4px;"></i> {{ employee.designation ?? 'Employee' }}
                            {% if employee.department %}
                                &bull; <i class="fa-solid fa-building" style="margin-left: 4px; margin-right: 4px;"></i> {{ employee.department.name }}
                            {% endif %}
                        {% else %}
                            Employee Profile Setup Pending
                        {% endif %}
                    </p>
                </div>
            </div>
            <div style="display:flex; gap:10px;">
                <a href="{{ path('app_leave_request_new') }}" class="btn" style="background: #ffffff; color: #059669; font-weight: 700; padding: 10px 18px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
                    <i class="fa-solid fa-plus-circle"></i> Apply for Leave
                </a>
                <a href="{{ path('app_salary_index') }}" class="btn" style="background: rgba(255,255,255,0.2); color: #ffffff; font-weight: 600; padding: 10px 18px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(255,255,255,0.3);">
                    <i class="fa-solid fa-wallet"></i> My Payslips
                </a>
            </div>
        </div>
    </div>
</div>

{# Attendance Punch Widget #}
<div class="card mb-4" style="border: 1px solid #e2e8f0; border-radius: 12px; background:#ffffff;">
    <div class="card-body" style="padding: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
        <div>
            <h5 style="font-weight: 700; margin: 0; display: flex; align-items: center; gap: 8px; color:#1e293b;">
                <i class="fa-solid fa-clock" style="color: #059669;"></i> Daily Attendance Status
            </h5>
            <p style="margin: 4px 0 0 0; font-size: 0.9rem; color: #64748b;">
                {% if todayAttendance is defined and todayAttendance %}
                    Check In Time: <strong style="color:#059669;">{{ todayAttendance.checkIn }}</strong>
                    {% if todayAttendance.checkOut %}
                         | Check Out Time: <strong style="color:#ef4444;">{{ todayAttendance.checkOut }}</strong>
                         {% if todayAttendance.workingHours %}
                             | Total Working Hours: <strong style="color:#6366f1;">{{ todayAttendance.workingHours }}</strong>
                         {% endif %}
                    {% endif %}
                {% else %}
                    You haven't checked in yet today.
                {% endif %}
            </p>
        </div>

        <div>
            {% if todayAttendance is not defined or not todayAttendance %}
                <form action="{{ path('app_attendance') }}" method="POST" style="margin: 0;">
                    <button type="submit" class="btn btn-success" style="font-weight: 700; padding: 10px 24px; border-radius: 8px; display: flex; align-items: center; gap: 8px;">
                        <i class="fa-solid fa-right-to-bracket"></i> Quick Check In Today
                    </button>
                </form>
            {% elseif todayAttendance and not todayAttendance.checkOut %}
                <form action="{{ path('app_attendance_checkout') }}" method="POST" style="margin: 0;">
                    <button type="submit" class="btn btn-danger" style="font-weight: 700; padding: 10px 24px; border-radius: 8px; display: flex; align-items: center; gap: 8px;">
                        <i class="fa-solid fa-right-from-bracket"></i> Quick Check Out Today
                    </button>
                </form>
            {% else %}
                <span class="badge badge-success" style="font-size: 0.95rem; padding: 10px 16px; border-radius: 8px;">
                    <i class="fa-solid fa-circle-check"></i> Present Today (Checked Out)
                </span>
            {% endif %}
        </div>
    </div>
</div>

{# Employee Personal Stat Cards Grid #}
<div class="stats-grid mb-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
    <div class="card" style="border-radius:12px; border:1px solid #e2e8f0; border-left: 4px solid #059669; padding: 18px;">
        <div style="font-size: 0.8rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">My Leave Requests</div>
        <div style="font-size: 1.8rem; font-weight: 800; color: #059669; margin-top: 4px;">{{ leaveRequests|length }}</div>
    </div>
    
    <div class="card" style="border-radius:12px; border:1px solid #e2e8f0; border-left: 4px solid #f59e0b; padding: 18px;">
        <div style="font-size: 0.8rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">My Assigned Tasks</div>
        <div style="font-size: 1.8rem; font-weight: 800; color: #f59e0b; margin-top: 4px;">{{ tasks|length }}</div>
    </div>

    <div class="card" style="border-radius:12px; border:1px solid #e2e8f0; border-left: 4px solid #3b82f6; padding: 18px;">
        <div style="font-size: 0.8rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">My Attendance Logs</div>
        <div style="font-size: 1.8rem; font-weight: 800; color: #3b82f6; margin-top: 4px;">{{ attendances|length }}</div>
    </div>

    <div class="card" style="border-radius:12px; border:1px solid #e2e8f0; border-left: 4px solid #8b5cf6; padding: 18px;">
        <div style="font-size: 0.8rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">My Payslips</div>
        <div style="font-size: 1.8rem; font-weight: 800; color: #8b5cf6; margin-top: 4px;">{{ salaries|length }}</div>
    </div>
</div>

{# Content Grid: Assigned Tasks & Recent Leave Requests #}
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 24px;">
    
    {# My Assigned Tasks #}
    <div class="card" style="border-radius:12px; border:1px solid #e2e8f0; overflow:hidden;">
        <div class="card-header" style="background:#ffffff; padding:16px 20px; border-bottom:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center;">
            <h5 style="margin:0; font-weight:700; color:#1e293b;">
                <i class="fa-solid fa-list-check" style="color:#059669; margin-right:8px;"></i> My Assigned Tasks
            </h5>
            <a href="{{ path('app_task_index') }}" class="btn btn-sm btn-outline-primary" style="border-radius:6px;">View Tasks</a>
        </div>
        <div class="card-body" style="padding:0;">
            <div class="table-responsive">
                <table class="table" style="margin:0; width:100%;">
                    <thead style="background:#f8fafc;">
                        <tr>
                            <th style="padding:14px 20px; font-weight:600; color:#64748b; font-size:0.8rem; text-transform:uppercase;">Task Title</th>
                            <th style="padding:14px 20px; font-weight:600; color:#64748b; font-size:0.8rem; text-transform:uppercase;">Priority</th>
                            <th style="padding:14px 20px; font-weight:600; color:#64748b; font-size:0.8rem; text-transform:uppercase;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for task in tasks %}
                        <tr style="border-bottom:1px solid #f1f5f9;">
                            <td style="padding:14px 20px;"><strong>{{ task.title }}</strong></td>
                            <td style="padding:14px 20px;">
                                <span class="badge badge-info">{{ task.priority ?? 'Normal' }}</span>
                            </td>
                            <td style="padding:14px 20px;">
                                <span class="badge badge-warning">{{ task.status }}</span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" style="text-align:center; padding:30px; color:#94a3b8;">
                                No tasks assigned to you right now.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# My Leave Requests #}
    <div class="card" style="border-radius:12px; border:1px solid #e2e8f0; overflow:hidden;">
        <div class="card-header" style="background:#ffffff; padding:16px 20px; border-bottom:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center;">
            <h5 style="margin:0; font-weight:700; color:#1e293b;">
                <i class="fa-solid fa-plane-departure" style="color:#f59e0b; margin-right:8px;"></i> My Leave Requests
            </h5>
            <a href="{{ path('app_leave_request_index') }}" class="btn btn-sm btn-outline-primary" style="border-radius:6px;">View All</a>
        </div>
        <div class="card-body" style="padding:0;">
            <div class="table-responsive">
                <table class="table" style="margin:0; width:100%;">
                    <thead style="background:#f8fafc;">
                        <tr>
                            <th style="padding:14px 20px; font-weight:600; color:#64748b; font-size:0.8rem; text-transform:uppercase;">Type</th>
                            <th style="padding:14px 20px; font-weight:600; color:#64748b; font-size:0.8rem; text-transform:uppercase;">Start</th>
                            <th style="padding:14px 20px; font-weight:600; color:#64748b; font-size:0.8rem; text-transform:uppercase;">End</th>
                            <th style="padding:14px 20px; font-weight:600; color:#64748b; font-size:0.8rem; text-transform:uppercase;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for leave in leaveRequests %}
                        <tr style="border-bottom:1px solid #f1f5f9;">
                            <td style="padding:14px 20px;"><strong>{{ leave.leaveType ?? 'Casual Leave' }}</strong></td>
                             <td style="padding:14px 20px;">{{ leave.startDate ? leave.startDate|date('Y-m-d') : '-' }}</td>
                             <td style="padding:14px 20px;">{{ leave.endDate ? leave.endDate|date('Y-m-d') : '-' }}</td>
                            <td style="padding:14px 20px;">
                                {% if leave.status == 'Approved' %}
                                    <span class="badge badge-success">Approved</span>
                                {% elseif leave.status == 'Rejected' %}
                                    <span class="badge badge-danger">Rejected</span>
                                {% else %}
                                    <span class="badge badge-warning">Pending</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" style="text-align:center; padding:30px; color:#94a3b8;">
                                No leave requests submitted yet.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}
