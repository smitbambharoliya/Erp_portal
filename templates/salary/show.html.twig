{% extends 'base.html.twig' %}

{% block title %}Salary Slip #{{ salary.id }} — HR Portal{% endblock %}
{% block page_heading %}Salary Slip Details{% endblock %}

{% block body %}
<div class="card" style="max-width:700px; margin:0 auto; border-radius:12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow:hidden;">
    <div class="card-header" style="background:linear-gradient(135deg, #1e293b, #0f172a); color:#ffffff; padding:24px; display:flex; justify-content:space-between; align-items:center;">
        <div>
            <h4 style="margin:0; font-weight:800; letter-spacing:0.5px;"><i class="fa-solid fa-file-invoice-dollar" style="color:var(--success); margin-right:10px;"></i> PAYSLIP</h4>
            <span style="font-size:0.85rem; opacity:0.8;">Month: {{ salary.month ?? 'N/A' }} {{ salary.year ?? '' }}</span>
        </div>
        <div>
            <a href="{{ path('app_salary_index') }}" class="btn btn-secondary btn-sm" style="padding:6px 14px; border-radius:6px;">
                <i class="fa-solid fa-arrow-left"></i> Back to List
            </a>
            <button onclick="window.print();" class="btn btn-info btn-sm" style="padding:6px 14px; border-radius:6px; color:#ffffff; margin-left:6px;">
                <i class="fa-solid fa-print"></i> Print
            </button>
        </div>
    </div>

    <div class="card-body" style="padding:24px;">
        <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:2px solid #f1f5f9; padding-bottom:16px; margin-bottom:20px;">
            <div>
                <span style="font-size:0.75rem; text-transform:uppercase; color:#64748b; font-weight:700; display:block;">Employee Details</span>
                <h5 style="margin:4px 0 0 0; font-weight:700; color:#1e293b;">
                    {{ salary.employee ? salary.employee.name : 'Unknown' }}
                </h5>
                <span style="font-size:0.85rem; color:#64748b;">
                    {{ salary.employee and salary.employee.department ? salary.employee.department.name : 'General Department' }}
                </span>
            </div>
            <div style="text-align:right;">
                <span style="font-size:0.75rem; text-transform:uppercase; color:#64748b; font-weight:700; display:block;">Payment Status</span>
                {% if salary.paymentStatus == 'Paid' %}
                    <span class="badge" style="background:#dcfce7; color:#15803d; font-weight:700; padding:6px 14px; border-radius:20px; font-size:0.85rem; margin-top:4px; display:inline-block;">
                        <i class="fa-solid fa-circle-check"></i> PAID
                    </span>
                {% else %}
                    <span class="badge" style="background:#fef3c7; color:#b45309; font-weight:700; padding:6px 14px; border-radius:20px; font-size:0.85rem; margin-top:4px; display:inline-block;">
                        <i class="fa-solid fa-clock"></i> {{ salary.paymentStatus ?? 'PENDING' }}
                    </span>
                {% endif %}
            </div>
        </div>

        <table style="width:100%; border-collapse:collapse; margin-bottom:24px;">
            <thead>
                <tr style="background:#f8fafc; border-bottom:1px solid #e2e8f0;">
                    <th style="padding:12px 16px; text-align:left; font-size:0.8rem; text-transform:uppercase; color:#64748b;">Earnings & Deductions</th>
                    <th style="padding:12px 16px; text-align:right; font-size:0.8rem; text-transform:uppercase; color:#64748b;">Amount (₹)</th>
                </tr>
            </thead>
            <tbody>
                <tr style="border-bottom:1px solid #f1f5f9;">
                    <td style="padding:14px 16px; font-weight:600; color:#334155;">Basic Salary</td>
                    <td style="padding:14px 16px; text-align:right; font-weight:600; color:#334155;">₹{{ salary.basicSalary ?? '0' }}</td>
                </tr>
                <tr style="border-bottom:1px solid #f1f5f9;">
                    <td style="padding:14px 16px; font-weight:600; color:#16a34a;">Bonus / Performance Incentive</td>
                    <td style="padding:14px 16px; text-align:right; font-weight:600; color:#16a34a;">+ ₹{{ salary.bonus ?? '0' }}</td>
                </tr>
                <tr style="border-bottom:1px solid #f1f5f9;">
                    <td style="padding:14px 16px; font-weight:600; color:#dc2626;">Deductions (Taxes / PF / Unpaid Leave)</td>
                    <td style="padding:14px 16px; text-align:right; font-weight:600; color:#dc2626;">- ₹{{ salary.deduction ?? '0' }}</td>
                </tr>
            </tbody>
        </table>

        <div style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:10px; padding:18px 24px; display:flex; justify-content:space-between; align-items:center;">
            <div>
                <span style="font-size:0.85rem; font-weight:700; color:#166534; text-transform:uppercase;">Total Net Payable Salary</span>
                <span style="display:block; font-size:0.75rem; color:#15803d;">Take Home Amount</span>
            </div>
            <div style="font-size:1.8rem; font-weight:800; color:#15803d;">
                ₹{{ salary.netSalary ?? '0' }}
            </div>
        </div>
    </div>

    {% if is_granted('ROLE_HR') %}
    <div style="padding:16px 24px; background:#f8fafc; border-top:1px solid #e2e8f0; text-align:right;">
        <a href="{{ path('app_salary_edit', {'id': salary.id}) }}" class="btn btn-primary" style="padding:8px 20px; font-weight:600; border-radius:8px;">
            <i class="fa-solid fa-pen"></i> Edit Record
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
