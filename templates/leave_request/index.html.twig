{% extends 'base.html.twig' %}

{% block title %}LeaveRequest index{% endblock %}

{% block body %}
    <h1>LeaveRequest index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>LeaveType</th>
                <th>StartDate</th>
                <th>EndDate</th>
                <th>Status</th>
                <th>ApprovedBy</th>
                <th>CreatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for leave_request in leave_requests %}
            <tr>
                <td>{{ leave_request.id }}</td>
                <td>{{ leave_request.leaveType }}</td>
                <td>{{ leave_request.startDate }}</td>
                <td>{{ leave_request.endDate }}</td>
                <td>{{ leave_request.status }}</td>
                <td>{{ leave_request.approvedBy }}</td>
                <td>{{ leave_request.createdAt ? leave_request.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_leave_request_show', {'id': leave_request.id}) }}">show</a>
                    <a href="{{ path('app_leave_request_edit', {'id': leave_request.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_leave_request_new') }}">Create new</a>
{% endblock %}
