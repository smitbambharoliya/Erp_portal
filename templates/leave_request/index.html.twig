{% extends 'base.html.twig' %}

{% block title %}Leave Requests — CoreUI ERP Portal{% endblock %}
{% block page_heading %}Leave Applications{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">
        <h5><i class="fa-solid fa-plane-departure" style="margin-right:8px; color:var(--warning);"></i> Leave Applications</h5>
        <a href="{{ path('app_leave_request_new') }}" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Apply Leave
        </a>
    </div>
    <div class="card-body" style="padding:0;">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Employee</th>
                        <th>Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for leave in leave_requests %}
                    <tr>
                        <td><strong>#{{ leave.id }}</strong></td>
                        <td>
                            <strong>
                                {% if leave.employee %}
                                    {{ leave.employee.firstName }} {{ leave.employee.lastName }}
                                {% else %}
                                    Unknown
                                {% endif %}
                            </strong>
                        </td>
                        <td><span class="badge badge-info">{{ leave.leaveType ?? 'Casual Leave' }}</span></td>
                        <td>{{ leave.startDate ?? '-' }}</td>
                        <td>{{ leave.endDate ?? '-' }}</td>
                        <td>
                            {% if leave.status == 'Approved' %}
                                <span class="badge badge-success">Approved</span>
                            {% elseif leave.status == 'Rejected' %}
                                <span class="badge badge-danger">Rejected</span>
                            {% else %}
                                <span class="badge badge-warning">Pending</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_leave_request_show', {'id': leave.id}) }}" class="btn btn-sm btn-secondary"><i class="fa-solid fa-eye"></i></a>
                            {% if is_granted('ROLE_HR') %}
                            <a href="{{ path('app_leave_request_edit', {'id': leave.id}) }}" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" style="text-align:center; padding:40px; color:var(--text-mute);">
                            No leave requests found.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
