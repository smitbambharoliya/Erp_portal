{% extends 'base.html.twig' %}

{% block title %}Leave Request Details — ERP Portal{% endblock %}
{% block page_heading %}Leave Application Details{% endblock %}

{% block body %}
<div class="card-panel" style="max-width:600px; margin:0 auto;">
    <div class="card-header-flex">
        <h2><i class="fa-solid fa-umbrella-beach" style="margin-right:8px; color:var(--warning);"></i> Application #{{ leave_request.id }}</h2>
        <a href="{{ path('app_leave_request_index') }}" class="btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Back to List
        </a>
    </div>

    <table class="custom-table" style="margin-top:16px;">
        <tbody>
            <tr>
                <th style="width:35%;">Applicant Employee</th>
                <td><strong>{{ leave_request.employee ? leave_request.employee.firstName ~ ' ' ~ leave_request.employee.lastName : 'Unknown' }}</strong></td>
            </tr>
            <tr>
                <th>Leave Type</th>
                <td><span class="badge badge-info">{{ leave_request.leaveType ?? 'Casual Leave' }}</span></td>
            </tr>
            <tr>
                <th>Start Date</th>
                <td>{{ leave_request.startDate ?? 'N/A' }}</td>
            </tr>
            <tr>
                <th>End Date</th>
                <td>{{ leave_request.endDate ?? 'N/A' }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>
                    {% if leave_request.status == 'Approved' %}
                        <span class="badge badge-active">Approved</span>
                    {% elseif leave_request.status == 'Rejected' %}
                        <span class="badge badge-inactive">Rejected</span>
                    {% else %}
                        <span class="badge badge-pending">Pending Approval</span>
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>

    {% if is_granted('ROLE_HR') %}
    <div style="margin-top:24px; text-align:right;">
        <a href="{{ path('app_leave_request_edit', {'id': leave_request.id}) }}" class="btn-primary">
            <i class="fa-solid fa-pen"></i> Review / Edit Status
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
