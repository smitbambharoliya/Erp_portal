{% extends 'base.html.twig' %}

{% block title %}LeaveRequest{% endblock %}

{% block body %}
    <h1>LeaveRequest</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ leave_request.id }}</td>
            </tr>
            <tr>
                <th>LeaveType</th>
                <td>{{ leave_request.leaveType }}</td>
            </tr>
            <tr>
                <th>StartDate</th>
                <td>{{ leave_request.startDate }}</td>
            </tr>
            <tr>
                <th>EndDate</th>
                <td>{{ leave_request.endDate }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ leave_request.status }}</td>
            </tr>
            <tr>
                <th>ApprovedBy</th>
                <td>{{ leave_request.approvedBy }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ leave_request.createdAt ? leave_request.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_leave_request_index') }}">back to list</a>

    <a href="{{ path('app_leave_request_edit', {'id': leave_request.id}) }}">edit</a>

    {{ include('leave_request/_delete_form.html.twig') }}
{% endblock %}
