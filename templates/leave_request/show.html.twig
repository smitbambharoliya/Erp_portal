{% extends 'base.html.twig' %}

{% block title %}Leave Request Details — CoreUI ERP Portal{% endblock %}
{% block page_heading %}Leave Application Details{% endblock %}

{% block body %}
<div class="card" style="max-width:600px; margin:0 auto;">
    <div class="card-header">
        <h5><i class="fa-solid fa-plane-departure" style="margin-right:8px; color:var(--warning);"></i> Application #{{ leave_request.id }}</h5>
        <a href="{{ path('app_leave_request_index') }}" class="btn btn-secondary btn-sm">
            <i class="fa-solid fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="card-body" style="padding:0;">
        <div class="table-responsive">
            <table class="table">
                <tbody>
                    <tr>
                        <th style="width:35%;">Applicant Employee</th>
                        <td><strong>{{ leave_request.employee ? leave_request.employee.firstName ~ ' ' ~ leave_request.employee.lastName : 'Unknown' }}</strong></td>
                    </tr>
                    <tr>
                        <th>Leave Type</th>
                        <td><span class="badge badge-info">{{ leave_request.leaveType ?? 'Casual Leave' }}</span></td>
                    </tr>
                    <tr>
                        <th>Start Date</th>
                        <td>{{ leave_request.startDate ? leave_request.startDate|date('Y-m-d') : 'N/A' }}</td>
                    </tr>
                    <tr>
                        <th>End Date</th>
                        <td>{{ leave_request.endDate ? leave_request.endDate|date('Y-m-d') : 'N/A' }}</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td>
                            {% if leave_request.status == 'Approved' %}
                                <span class="badge badge-success">Approved</span>
                            {% elseif leave_request.status == 'Rejected' %}
                                <span class="badge badge-danger">Rejected</span>
                            {% else %}
                                <span class="badge badge-warning">Pending Approval</span>
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    {% if is_granted('ROLE_HR') %}
    <div style="padding:16px 20px; text-align:right; border-top:1px solid var(--border-color);">
        <a href="{{ path('app_leave_request_edit', {'id': leave_request.id}) }}" class="btn btn-primary">
            <i class="fa-solid fa-pen"></i> Review / Edit Status
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
